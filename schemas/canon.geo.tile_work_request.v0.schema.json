{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.geo.tile_work_request.v0.schema.json",
  "title": "canon.geo.tile_work_request.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "center_cell",
    "halo_k",
    "features",
    "max_features",
    "max_work_cells"
  ],
  "properties": {
    "version": { "const": "canon_geo_tile_work_request.v0" },
    "center_cell": { "$ref": "#/$defs/h3_cell" },
    "halo_k": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "features": {
      "type": "array",
      "items": { "$ref": "#/$defs/feature_ref" }
    },
    "max_features": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "max_work_cells": { "type": "integer", "minimum": 1, "maximum": 100000 }
  },
  "$defs": {
    "h3_cell": {
      "type": "string",
      "pattern": "^[0-9a-f]{15}$"
    },
    "feature_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "feature_id", "home_cell"],
      "properties": {
        "source_name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "feature_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "home_cell": { "$ref": "#/$defs/h3_cell" }
      }
    }
  }
}
