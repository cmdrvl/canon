{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.as_of_resolution.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "request_blake3",
    "as_of_utc_day",
    "tile_layer",
    "resolutions",
    "summary"
  ],
  "properties": {
    "version": { "type": "string", "const": "canon_geo_as_of_resolution.v0" },
    "request_blake3": { "$ref": "#/$defs/blake3_digest" },
    "as_of_utc_day": { "$ref": "#/$defs/utc_day" },
    "tile_layer": { "$ref": "#/$defs/layer_window" },
    "client_layer": { "$ref": "#/$defs/layer_window" },
    "temporal_scope": { "$ref": "#/$defs/temporal_scope" },
    "resolutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolution" }
    },
    "entity_resolutions": {
      "type": "array",
      "items": { "$ref": "#/$defs/entity_resolution" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "as_of_utc_day",
        "tile_layer"
      ],
      "properties": {
        "version": {
          "type": "string",
          "const": "canon_geo_as_of_resolution_request.v0"
        },
        "as_of_utc_day": { "$ref": "#/$defs/utc_day" },
        "tile_layer": { "$ref": "#/$defs/layer_window" },
        "client_layer": { "$ref": "#/$defs/layer_window" },
        "temporal_scope": { "$ref": "#/$defs/temporal_scope" },
        "lookups": {
          "type": "array",
          "items": { "$ref": "#/$defs/lookup" }
        },
        "parcel_vintages": {
          "type": "array",
          "items": { "$ref": "#/$defs/parcel_vintage_row" }
        },
        "change_ledger": {
          "type": "array",
          "items": { "$ref": "#/$defs/change_ledger_row" }
        },
        "entity_lookups": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_lookup" }
        },
        "entity_vintages": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_vintage_row" }
        },
        "lifecycle_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_transition_row" }
        }
      }
    },
    "utc_day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "bbl_key": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "blake3_digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "entity_level": {
      "type": "string",
      "enum": [
        "building",
        "parcel",
        "property"
      ]
    },
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "start_utc_day",
        "end_utc_day"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "as_of",
            "across_vintage_range"
          ]
        },
        "start_utc_day": { "$ref": "#/$defs/utc_day" },
        "end_utc_day": { "$ref": "#/$defs/utc_day" }
      }
    },
    "layer_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_id",
        "source_dataset",
        "vintage_id",
        "valid_from_utc_day",
        "valid_to_utc_day",
        "content_digest"
      ],
      "properties": {
        "layer_id": { "type": "string", "minLength": 1 },
        "source_dataset": { "type": "string", "minLength": 1 },
        "vintage_id": { "type": "string", "minLength": 1 },
        "valid_from_utc_day": { "$ref": "#/$defs/utc_day" },
        "valid_to_utc_day": { "$ref": "#/$defs/utc_day" },
        "content_digest": { "$ref": "#/$defs/blake3_digest" }
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookup_id",
        "bbl_key"
      ],
      "properties": {
        "lookup_id": { "type": "string", "minLength": 1 },
        "bbl_key": { "$ref": "#/$defs/bbl_key" }
      }
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_level",
        "identifier_namespace",
        "identifier_value"
      ],
      "properties": {
        "entity_level": { "$ref": "#/$defs/entity_level" },
        "identifier_namespace": { "type": "string", "minLength": 1 },
        "identifier_value": { "type": "string", "minLength": 1 }
      }
    },
    "entity_lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookup_id",
        "entity_ref"
      ],
      "properties": {
        "lookup_id": { "type": "string", "minLength": 1 },
        "entity_ref": { "$ref": "#/$defs/entity_ref" }
      }
    },
    "parcel_vintage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bbl_key",
        "release",
        "release_dt",
        "valid_from_release_dt"
      ],
      "properties": {
        "bbl_key": { "$ref": "#/$defs/bbl_key" },
        "release": { "type": "string", "minLength": 1 },
        "release_dt": { "$ref": "#/$defs/utc_day" },
        "valid_from_release_dt": { "$ref": "#/$defs/utc_day" },
        "valid_to_release_dt": { "$ref": "#/$defs/utc_day" },
        "geometry_digest": { "type": "string", "minLength": 1 },
        "parcel_cluster_id": {
          "type": "string",
          "pattern": "^cmdrvl:parcel:"
        },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_record_blake3": { "$ref": "#/$defs/blake3_digest" }
      }
    },
    "entity_vintage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_ref",
        "source_dataset",
        "release",
        "release_dt",
        "valid_from_utc_day",
        "source_record_id",
        "source_record_blake3"
      ],
      "properties": {
        "entity_ref": { "$ref": "#/$defs/entity_ref" },
        "source_dataset": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "release_dt": { "$ref": "#/$defs/utc_day" },
        "valid_from_utc_day": { "$ref": "#/$defs/utc_day" },
        "valid_to_utc_day": { "$ref": "#/$defs/utc_day" },
        "geometry_digest": { "type": "string", "minLength": 1 },
        "entity_cluster_id": {
          "type": "string",
          "pattern": "^cmdrvl:(building|parcel|property):"
        },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_record_blake3": { "$ref": "#/$defs/blake3_digest" }
      }
    },
    "transition_type": {
      "type": "string",
      "enum": [
        "create",
        "retire",
        "split",
        "merge",
        "renumber"
      ]
    },
    "lifecycle_transition_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "transition_type",
        "event_utc_day",
        "source_dataset",
        "source_record_id",
        "source_record_blake3"
      ],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "transition_type": { "$ref": "#/$defs/transition_type" },
        "event_utc_day": { "$ref": "#/$defs/utc_day" },
        "source_dataset": { "type": "string", "minLength": 1 },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_record_blake3": { "$ref": "#/$defs/blake3_digest" },
        "predecessor_entity_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_ref" }
        },
        "successor_entity_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_ref" }
        }
      }
    },
    "change_ledger_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_event_id",
        "event_type",
        "current_release",
        "current_release_dt",
        "subject_bbl_key"
      ],
      "properties": {
        "change_event_id": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "canon_resolution": { "type": "string", "minLength": 1 },
        "previous_release": { "type": "string", "minLength": 1 },
        "previous_release_dt": { "$ref": "#/$defs/utc_day" },
        "current_release": { "type": "string", "minLength": 1 },
        "current_release_dt": { "$ref": "#/$defs/utc_day" },
        "subject_bbl_key": { "$ref": "#/$defs/bbl_key" },
        "resolved_bbl_key": { "$ref": "#/$defs/bbl_key" },
        "canonical_bbl_key": { "$ref": "#/$defs/bbl_key" },
        "predecessor_candidate_bbl_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/bbl_key" }
        },
        "successor_candidate_bbl_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/bbl_key" }
        },
        "source_record_id": { "type": "string", "minLength": 1 },
        "source_record_blake3": { "$ref": "#/$defs/blake3_digest" }
      }
    },
    "event_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_event_id",
        "event_type",
        "current_release",
        "current_release_dt",
        "subject_bbl_key"
      ],
      "properties": {
        "change_event_id": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "current_release": { "type": "string", "minLength": 1 },
        "current_release_dt": { "$ref": "#/$defs/utc_day" },
        "subject_bbl_key": { "$ref": "#/$defs/bbl_key" },
        "predecessor_bbl_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/bbl_key" }
        },
        "successor_bbl_keys": {
          "type": "array",
          "items": { "$ref": "#/$defs/bbl_key" }
        }
      }
    },
    "lifecycle_transition_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "transition_type",
        "event_utc_day",
        "source_dataset"
      ],
      "properties": {
        "transition_id": { "type": "string", "minLength": 1 },
        "transition_type": { "$ref": "#/$defs/transition_type" },
        "event_utc_day": { "$ref": "#/$defs/utc_day" },
        "source_dataset": { "type": "string", "minLength": 1 },
        "predecessor_entity_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_ref" }
        },
        "successor_entity_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/entity_ref" }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookup_id",
        "bbl_key",
        "status",
        "reason"
      ],
      "properties": {
        "lookup_id": { "type": "string", "minLength": 1 },
        "bbl_key": { "$ref": "#/$defs/bbl_key" },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "abstained"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "active_at_as_of",
            "ambiguous_vintage_rows",
            "changed_before_as_of",
            "not_present_as_of"
          ]
        },
        "parcel_cluster_id": {
          "type": "string",
          "pattern": "^cmdrvl:parcel:"
        },
        "matched_release": { "type": "string", "minLength": 1 },
        "matched_release_dt": { "$ref": "#/$defs/utc_day" },
        "matched_valid_from_release_dt": { "$ref": "#/$defs/utc_day" },
        "matched_valid_to_release_dt": { "$ref": "#/$defs/utc_day" },
        "change_events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event_ref" }
        }
      }
    },
    "entity_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookup_id",
        "entity_ref",
        "status",
        "reason"
      ],
      "properties": {
        "lookup_id": { "type": "string", "minLength": 1 },
        "entity_ref": { "$ref": "#/$defs/entity_ref" },
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "abstained"
          ]
        },
        "reason": {
          "type": "string",
          "enum": [
            "active_at_as_of",
            "active_within_vintage_range",
            "ambiguous_vintage_rows",
            "changed_before_scope_end",
            "not_present_in_scope"
          ]
        },
        "entity_cluster_id": {
          "type": "string",
          "pattern": "^cmdrvl:(building|parcel|property):"
        },
        "matched_source_dataset": { "type": "string", "minLength": 1 },
        "matched_release": { "type": "string", "minLength": 1 },
        "matched_release_dt": { "$ref": "#/$defs/utc_day" },
        "matched_valid_from_utc_day": { "$ref": "#/$defs/utc_day" },
        "matched_valid_to_utc_day": { "$ref": "#/$defs/utc_day" },
        "lifecycle_transitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/lifecycle_transition_ref" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookups",
        "resolved",
        "abstained",
        "change_events_used"
      ],
      "properties": {
        "lookups": { "type": "integer", "minimum": 0 },
        "resolved": { "type": "integer", "minimum": 0 },
        "abstained": { "type": "integer", "minimum": 0 },
        "change_events_used": { "type": "integer", "minimum": 0 },
        "entity_lookups": { "type": "integer", "minimum": 0 },
        "entity_resolved": { "type": "integer", "minimum": 0 },
        "entity_abstained": { "type": "integer", "minimum": 0 },
        "lifecycle_transitions_used": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
