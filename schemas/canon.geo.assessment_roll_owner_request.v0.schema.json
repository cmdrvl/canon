{
  "$id": "https://cmdrvl.com/schemas/canon.geo.assessment_roll_owner_request.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.assessment_roll_owner_request.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_assessment_roll_owner_request.v0",
      "type": "string"
    },
    "proof_class": {
      "$ref": "#/$defs/proof_class"
    },
    "population": {
      "$ref": "canon.geo.population_request.v0.schema.json"
    },
    "case_documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_document"
      }
    },
    "contract_source": {
      "$ref": "#/$defs/contract_source"
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    },
    "roll_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/roll_row"
      }
    },
    "party_rows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/party_row"
      }
    },
    "max_cases": {
      "type": "integer",
      "minimum": 1
    },
    "max_roll_rows": {
      "type": "integer",
      "minimum": 1
    },
    "max_party_rows": {
      "type": "integer",
      "minimum": 0
    },
    "max_overlay_observations": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "version",
    "proof_class",
    "population",
    "case_documents",
    "contract_source",
    "calibration",
    "roll_rows",
    "party_rows",
    "max_cases",
    "max_roll_rows",
    "max_party_rows",
    "max_overlay_observations"
  ],
  "$defs": {
    "proof_class": {
      "type": "string",
      "enum": [
        "fixture",
        "observed_warehouse_snapshot"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "bbl": {
      "type": "string",
      "pattern": "^[0-9]{10}$"
    },
    "blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_document": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "$ref": "#/$defs/identifier"
        },
        "document_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "case_id",
        "document_id"
      ]
    },
    "contract_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_dataset": {
          "$ref": "#/$defs/identifier"
        },
        "source_release": {
          "$ref": "#/$defs/identifier"
        },
        "source_lineage_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "required": [
        "source_dataset",
        "source_release",
        "source_lineage_ids"
      ]
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population_id": {
          "$ref": "#/$defs/identifier"
        },
        "calibration_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "exact_falsification_rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "affiliate_falsification_rule_id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "population_id",
        "calibration_blake3",
        "exact_falsification_rule_id",
        "affiliate_falsification_rule_id"
      ]
    },
    "roll_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bbl": {
          "$ref": "#/$defs/bbl"
        },
        "owner": {
          "type": "string"
        },
        "gross_sqft": {
          "type": "string"
        },
        "units": {
          "type": "string"
        },
        "condo_number": {
          "type": "string"
        },
        "source_record_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_vintage": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "bbl",
        "owner",
        "gross_sqft",
        "units",
        "condo_number",
        "source_record_id",
        "source_vintage"
      ]
    },
    "party_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "$ref": "#/$defs/identifier"
        },
        "party_type": {
          "const": "1",
          "type": "string"
        },
        "party_name_norm": {
          "$ref": "#/$defs/identifier"
        },
        "source_record_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_vintage": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "document_id",
        "party_type",
        "party_name_norm",
        "source_record_id",
        "source_vintage"
      ]
    }
  },
  "x-canon-contract": {
    "runtime_only_invariants": [
      "case_documents exactly covers population.cases by case_id",
      "roll_rows are unique by 10-digit BBL",
      "party_rows are ACRIS party_type 1 and party_name_norm already equals STG_GEO_NYC_ACRIS_PARTIES.PARTY_NAME_NORM",
      "widening is exact set union of existing parcel universe and roll BBLs sharing each existing BBL block",
      "fixture proof_class is not live acquisition proof"
    ]
  }
}
