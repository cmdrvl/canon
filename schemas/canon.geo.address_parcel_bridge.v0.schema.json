{
  "$id": "https://cmdrvl.com/schemas/canon.geo.address_parcel_bridge.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.address_parcel_bridge.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_address_parcel_bridge.v0",
      "type": "string"
    },
    "request_version": {
      "type": "string"
    },
    "parse_forest_version": {
      "type": "string"
    },
    "pad_membership_version": {
      "type": "string"
    },
    "grammar": {
      "$ref": "canon.geo.address_parse_forest.v0.schema.json#/$defs/grammar_ref"
    },
    "jurisdiction": {
      "$ref": "canon.geo.address_parse_request.v0.schema.json#/$defs/address_jurisdiction"
    },
    "input": {
      "type": "string"
    },
    "query_as_of": {
      "$ref": "#/$defs/as_of"
    },
    "status": {
      "$ref": "#/$defs/bridge_status"
    },
    "readings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reading_support"
      }
    },
    "parcel_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity_ref"
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_record_ref"
      }
    },
    "valid_time": {
      "$ref": "#/$defs/valid_time_interval"
    },
    "observation": {
      "$ref": "#/$defs/rho_observation"
    },
    "diagnostic": {
      "$ref": "#/$defs/diagnostic"
    }
  },
  "required": [
    "version",
    "request_version",
    "parse_forest_version",
    "pad_membership_version",
    "grammar",
    "jurisdiction",
    "input",
    "status",
    "readings"
  ],
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "status": {
              "const": "evidence_observation"
            }
          },
          "required": [
            "status",
            "observation"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "diagnostic_abstention"
            }
          },
          "required": [
            "status",
            "diagnostic"
          ]
        }
      ]
    }
  ],
  "$defs": {
    "as_of": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "utc_day": {
          "type": "string"
        },
        "semantic_id": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/value_origin"
        }
      },
      "required": [
        "utc_day",
        "semantic_id",
        "unit",
        "origin"
      ]
    },
    "bridge_status": {
      "type": "string",
      "enum": [
        "evidence_observation",
        "diagnostic_abstention"
      ]
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/diagnostic_code"
        },
        "message": {
          "type": "string"
        },
        "candidate_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_member_ids_without_source_records": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "diagnostic_code": {
      "type": "string",
      "enum": [
        "no_parse_readings",
        "no_source_member_support",
        "no_bound_source_records"
      ]
    },
    "entity_level": {
      "type": "string",
      "enum": [
        "parcel"
      ]
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/entity_level"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "id"
      ]
    },
    "evidence_record_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_record_id": {
          "type": "string"
        },
        "source_vintage": {
          "type": "string"
        },
        "record_blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_record_id",
        "source_vintage",
        "record_blake3"
      ]
    },
    "integer_measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic_id": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "value_origin": {
          "type": "string",
          "enum": [
            "source_asserted",
            "exact_derived"
          ]
        }
      },
      "required": [
        "semantic_id",
        "unit",
        "value_origin"
      ]
    },
    "integer_member_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "pad_candidate_status": {
      "type": "string",
      "enum": [
        "exact_member",
        "range_contained",
        "covered_by_address_set",
        "compatible_only",
        "no_source_member"
      ]
    },
    "reading_support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reading_id": {
          "type": "string"
        },
        "candidate_key": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/pad_candidate_status"
        },
        "asserted_member": {
          "type": "boolean"
        },
        "matched_member_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_supported_member_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parcel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reading_id",
        "candidate_key",
        "status",
        "asserted_member"
      ]
    },
    "rho_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "contract_id": {
          "type": "string"
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence_record_ref"
          }
        },
        "valid_time": {
          "$ref": "#/$defs/valid_time_interval"
        },
        "observation": {
          "$ref": "#/$defs/rho_observation_kind"
        }
      },
      "required": [
        "id",
        "contract_id",
        "source_records",
        "observation"
      ]
    },
    "rho_observation_kind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "existential_membership"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entity_ref"
          }
        }
      },
      "required": [
        "kind",
        "members"
      ]
    },
    "valid_time_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_day": {
          "type": "integer"
        },
        "end_day": {
          "type": "integer"
        }
      },
      "required": [
        "start_day",
        "end_day"
      ]
    },
    "value_origin": {
      "type": "string",
      "enum": [
        "caller_declared",
        "binary_default",
        "source_release",
        "local_artifact",
        "adapter_contract",
        "operator_policy"
      ]
    }
  }
}
