{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.geo.tile_reconciliation_request.v1.schema.json",
  "title": "canon.geo.tile_reconciliation_request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "halo_k", "batches", "max_batches", "max_proposals", "max_members_per_decision", "max_features_per_batch", "max_work_cells_per_batch"],
  "properties": {
    "version": { "const": "canon_geo_tile_reconciliation_request.v1" },
    "halo_k": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "inventory_lineage": { "$ref": "#/$defs/inventory_lineage" },
    "batches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision_batch" } },
    "max_batches": { "$ref": "#/$defs/uint64", "minimum": 1, "maximum": 100000 },
    "max_proposals": { "$ref": "#/$defs/uint64", "minimum": 1, "maximum": 1000000 },
    "max_members_per_decision": { "$ref": "#/$defs/uint64", "minimum": 1, "maximum": 100000 },
    "max_features_per_batch": { "$ref": "#/$defs/uint64", "minimum": 1, "maximum": 1000000 },
    "max_work_cells_per_batch": { "$ref": "#/$defs/uint64", "minimum": 1, "maximum": 100000 }
  },
  "$defs": {
    "int64": { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
    "uint64": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "blake3": { "type": "string", "pattern": "^blake3:[0-9a-f]{64}$" },
    "h3_cell": { "type": "string", "pattern": "^[0-9a-f]{15}$" },
    "entity_level": { "enum": ["site", "property", "parcel", "building", "unit", "address", "poi"] },
    "relation": { "enum": ["same_as", "contains", "part_of", "within", "on", "fronts", "intersects"] },
    "non_equivalence_relation": { "enum": ["contains", "part_of", "within", "on", "fronts", "intersects"] },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "release_digest"],
      "properties": {
        "release_id": { "$ref": "#/$defs/identifier" },
        "release_digest": { "$ref": "#/$defs/blake3" }
      }
    },
    "inventory_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "semantic_hash", "planning_hash"],
      "properties": {
        "inventory_id": { "$ref": "#/$defs/identifier" },
        "semantic_hash": { "$ref": "#/$defs/blake3" },
        "planning_hash": { "$ref": "#/$defs/blake3" }
      }
    },
    "inventory_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_ref", "inventory"],
      "properties": {
        "inventory_ref": { "$ref": "#/$defs/inventory_ref" },
        "inventory": { "$ref": "canon.geo.regional_inventory.v1.schema.json" }
      }
    },
    "native_scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_level", "identity_participation"],
          "properties": {
            "kind": { "const": "native_entity" },
            "entity_level": { "$ref": "#/$defs/entity_level" },
            "identity_participation": { "enum": ["stable_alias", "evidence_only"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "observation_only" } }
        }
      ]
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_instance_id", "release", "native_scope", "inventory_ref"],
      "properties": {
        "source_instance_id": { "$ref": "#/$defs/identifier" },
        "release": { "$ref": "#/$defs/release" },
        "native_scope": { "$ref": "#/$defs/native_scope" },
        "inventory_ref": { "$ref": "#/$defs/inventory_ref" }
      }
    },
    "decision_semantics": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "composition" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entity_level"],
          "properties": {
            "kind": { "const": "stable_identity" },
            "entity_level": { "$ref": "#/$defs/entity_level" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "relation", "from_entity_level", "to_entity_level"],
          "properties": {
            "kind": { "const": "relation" },
            "relation": { "$ref": "#/$defs/non_equivalence_relation" },
            "from_entity_level": { "$ref": "#/$defs/entity_level" },
            "to_entity_level": { "$ref": "#/$defs/entity_level" }
          }
        }
      ]
    },
    "decision_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "feature_id", "candidate_entity_level", "home_cell"],
      "properties": {
        "source": { "$ref": "#/$defs/source_binding" },
        "feature_id": { "$ref": "#/$defs/identifier" },
        "candidate_entity_level": { "$ref": "#/$defs/entity_level" },
        "home_cell": { "$ref": "#/$defs/h3_cell" }
      }
    },
    "decision_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantics", "work_unit_blake3", "payload_blake3", "members"],
      "properties": {
        "semantics": { "$ref": "#/$defs/decision_semantics" },
        "work_unit_blake3": { "$ref": "#/$defs/blake3" },
        "payload_blake3": { "$ref": "#/$defs/blake3" },
        "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision_member" } }
      }
    },
    "feature_membership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "feature_id", "home_cell", "placement"],
      "properties": {
        "source": { "$ref": "#/$defs/source_binding" },
        "feature_id": { "$ref": "#/$defs/identifier" },
        "home_cell": { "$ref": "#/$defs/h3_cell" },
        "placement": { "enum": ["center", "halo"] }
      }
    },
    "work_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "request_version", "center_cell", "h3_resolution", "halo_k", "work_cells", "features", "center_feature_count", "halo_feature_count", "max_features", "max_work_cells", "work_unit_blake3"],
      "properties": {
        "version": { "const": "canon_geo_tile_work_unit.v1" },
        "request_version": { "const": "canon_geo_tile_work_request.v1" },
        "center_cell": { "$ref": "#/$defs/h3_cell" },
        "h3_resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
        "halo_k": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "work_cells": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/h3_cell" } },
        "features": { "type": "array", "items": { "$ref": "#/$defs/feature_membership" } },
        "center_feature_count": { "$ref": "#/$defs/uint64" },
        "halo_feature_count": { "$ref": "#/$defs/uint64" },
        "max_features": { "$ref": "#/$defs/uint64", "minimum": 1, "maximum": 1000000 },
        "max_work_cells": { "$ref": "#/$defs/uint64", "minimum": 1, "maximum": 100000 },
        "work_unit_blake3": { "$ref": "#/$defs/blake3" }
      }
    },
    "decision_batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_unit", "proposals"],
      "properties": {
        "work_unit": { "$ref": "#/$defs/work_unit" },
        "proposals": { "type": "array", "items": { "$ref": "#/$defs/decision_proposal" } }
      }
    }
  },
  "x-canon-contract": {
    "canonical_contract": "canon_geo_tile_reconciliation_request.v1",
    "runtime_only_invariants": [
      "identifier limits are 256 UTF-8 bytes; JSON Schema maxLength counts Unicode characters",
      "every proposal member matches an exact work-unit membership including source, release, native scope, feature_id, and home cell",
      "candidate_entity_level equals the member source native entity level",
      "ObservationOnly sources cannot be candidate members",
      "Composition semantics may span levels and contain only EvidenceOnly members but carry no alias-mint authority",
      "StableIdentity semantics require supplied inventory lineage whose canonical bytes recompute to the declared inventory semantic and planning hashes, every member at the declared entity level, exact member source/release/native-scope agreement with that inventory, and at least one exact same-level StableAlias member",
      "Relation semantics require exactly two native candidate members, one at each declared endpoint level; endpoint levels must differ and same_as is forbidden by both runtime validation and schema because stable_identity owns equivalence",
      "Composition may omit inventory lineage and carries no stable-alias authority",
      "one source_instance_id has exactly one release identity, native scope, and inventory reference across all batches",
      "each proposal work_unit_blake3 equals its embedded canonical work-unit digest; this deterministic association is not proof that an external solver consumed the work unit",
      "decision semantics and canonical members jointly determine confluence scope and decision identity",
      "member, batch-receipt, and reconciled-decision collections are canonicalized before hashing or emission"
    ]
  }
}
