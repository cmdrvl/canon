{
  "$id": "https://cmdrvl.com/schemas/canon.geo.evidence_compilation.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.evidence_compilation.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_evidence_compilation.v0",
      "type": "string"
    },
    "request_version": {
      "type": "string"
    },
    "composition_request": {
      "$ref": "#/$defs/composition_request"
    },
    "admissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_admission"
      }
    }
  },
  "required": [
    "version",
    "request_version",
    "composition_request",
    "admissions"
  ],
  "$defs": {
    "entity_level": {
      "type": "string",
      "enum": [
        "poi_unit",
        "building",
        "parcel",
        "property"
      ]
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/entity_level"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "id"
      ]
    },
    "composition_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "canon_geo_composition_profile.v0",
          "type": "string"
        },
        "selection_level": {
          "$ref": "#/$defs/entity_level"
        }
      },
      "required": [
        "version",
        "selection_level"
      ]
    },
    "building_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parcel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "parcel_ids"
      ]
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parcels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "buildings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/building_candidate"
          }
        }
      },
      "required": [
        "parcels",
        "buildings"
      ]
    },
    "integer_member_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "integer_measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic_id": { "type": "string" },
        "unit": { "type": "string" },
        "value_origin": {
          "type": "string",
          "enum": ["source_asserted", "exact_derived"]
        }
      },
      "required": ["semantic_id", "unit", "value_origin"]
    },
    "hard_constraint_kind": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "require"
            },
            "member": {
              "$ref": "#/$defs/entity_ref"
            }
          },
          "required": [
            "kind",
            "member"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "forbid"
            },
            "member": {
              "$ref": "#/$defs/entity_ref"
            }
          },
          "required": [
            "kind",
            "member"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cardinality"
            },
            "level": {
              "$ref": "#/$defs/entity_level"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "level",
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "allowed_sets"
            },
            "level": {
              "$ref": "#/$defs/entity_level"
            },
            "sets": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "kind",
            "level",
            "sets"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "any_of"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entity_ref"
              }
            }
          },
          "required": [
            "kind",
            "members"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer_sum_band"
            },
            "level": {
              "$ref": "#/$defs/entity_level"
            },
            "measure": {
              "$ref": "#/$defs/integer_measure"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/integer_member_value"
              }
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "level",
            "measure",
            "values",
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "all_or_none"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entity_ref"
              }
            }
          },
          "required": [
            "kind",
            "members"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "requires"
            },
            "if_member": {
              "$ref": "#/$defs/entity_ref"
            },
            "then_member": {
              "$ref": "#/$defs/entity_ref"
            }
          },
          "required": [
            "kind",
            "if_member",
            "then_member"
          ]
        }
      ]
    },
    "hard_constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "constraint": {
          "$ref": "#/$defs/hard_constraint_kind"
        }
      },
      "required": [
        "id",
        "constraint"
      ]
    },
    "soft_preference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "member": {
          "$ref": "#/$defs/entity_ref"
        },
        "cost_if_absent": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "member",
        "cost_if_absent"
      ]
    },
    "composition_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "canon_geo_composition_request.v0",
          "type": "string"
        },
        "profile": {
          "$ref": "#/$defs/composition_profile"
        },
        "universe": {
          "$ref": "#/$defs/universe"
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hard_constraint"
          }
        },
        "soft_preferences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/soft_preference"
          }
        },
        "max_assignments": {
          "type": "integer",
          "minimum": 0
        },
        "max_materialized_models": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "profile",
        "universe",
        "hard_constraints",
        "soft_preferences",
        "max_assignments",
        "max_materialized_models"
      ]
    },
    "rho_basis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "logical_relaxation" },
            "invariant_id": { "type": "string" }
          },
          "required": ["kind", "invariant_id"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "empirical_calibration" },
            "population_id": { "type": "string" },
            "calibration_blake3": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "falsification_rule_id": { "type": "string" }
          },
          "required": [
            "kind",
            "population_id",
            "calibration_blake3",
            "falsification_rule_id"
          ]
        }
      ]
    },
    "rho_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "source_dataset": { "type": "string" },
        "source_release": { "type": "string" },
        "source_lineage_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "method_id": { "type": "string" },
        "method_version": { "type": "string" },
        "claim_role": {
          "type": "string",
          "enum": [
            "stable_identity_anchor",
            "temporal_occupancy",
            "lifecycle_event",
            "attribute_observation"
          ]
        },
        "basis": { "$ref": "#/$defs/rho_basis" }
      },
      "required": [
        "id",
        "version",
        "source_dataset",
        "source_release",
        "source_lineage_ids",
        "method_id",
        "method_version",
        "claim_role",
        "basis"
      ]
    },
    "rho_observation_kind": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "exact_sets" },
            "level": { "$ref": "#/$defs/entity_level" },
            "sets": {
              "type": "array",
              "items": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          },
          "required": ["kind", "level", "sets"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "existential_membership" },
            "members": {
              "type": "array",
              "items": { "$ref": "#/$defs/entity_ref" }
            }
          },
          "required": ["kind", "members"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "integer_sum_band" },
            "level": { "$ref": "#/$defs/entity_level" },
            "measure": { "$ref": "#/$defs/integer_measure" },
            "values": {
              "type": "array",
              "items": { "$ref": "#/$defs/integer_member_value" }
            },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          },
          "required": ["kind", "level", "measure", "values", "min", "max"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "prefer_member" },
            "member": { "$ref": "#/$defs/entity_ref" },
            "cost_if_absent": { "type": "integer", "minimum": 0 }
          },
          "required": ["kind", "member", "cost_if_absent"]
        }
      ]
    },
    "evidence_record_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_record_id": { "type": "string" },
        "source_vintage": { "type": "string" },
        "record_blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["source_record_id", "source_vintage", "record_blake3"]
    },
    "valid_time_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_day": { "type": "integer" },
        "end_day": { "type": "integer" }
      },
      "required": ["start_day", "end_day"]
    },
    "evidence_disposition": {
      "type": "string",
      "enum": [
        "hard_constraint",
        "soft_preference",
        "diagnostic_only"
      ]
    },
    "evidence_admission": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "type": "string"
        },
        "contract": {
          "$ref": "#/$defs/rho_contract"
        },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_record_ref" }
        },
        "valid_time": { "$ref": "#/$defs/valid_time_interval" },
        "observation": { "$ref": "#/$defs/rho_observation_kind" },
        "disposition": {
          "$ref": "#/$defs/evidence_disposition"
        },
        "generated_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "observation_id",
        "contract",
        "source_records",
        "observation",
        "disposition"
      ]
    }
  }
}
