{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.geo.point_parcel_request.v0.schema.json",
  "title": "Native point-to-parcel evidence input, one dependent source family",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "target_ref", "target_relation", "target_source_records", "source_as_of", "source_transform", "family", "inventory_source", "frame", "points", "candidates", "acquisition_truncated", "max_relation_pairs", "max_predicates", "max_vertices_per_geometry", "max_geometry_bytes", "max_report_bytes", "max_assignments", "max_materialized_models"],
  "properties": {
    "version": {"const": "canon_geo_point_parcel_request.v0"},
    "target_ref": {"$ref": "#/$defs/id"},
    "target_relation": {"enum": ["physical_component_of", "proposed_component_of", "associated_observation_of"]},
    "target_source_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/record"}},
    "source_as_of": {"$ref": "#/$defs/id"},
    "source_transform": {"$ref": "#/$defs/source_transform"},
    "family": {
      "$ref": "canon.geo.evidence_request.v0.schema.json#/$defs/rho_contract",
      "properties": {"claim_role": {"const": "attribute_observation"}, "source_lineage_ids": {"minItems": 1}, "basis": {"properties": {"kind": {"const": "uncalibrated"}, "admission_policy": {"type": "object", "additionalProperties": false, "required": ["kind", "cost_if_absent"], "properties": {"kind": {"const": "soft_with_weight"}, "cost_if_absent": {"type": "integer", "minimum": 1}}}}}}
    },
    "inventory_source": {"$ref": "canon.geo.tile_work_request.v1.schema.json#/$defs/source_binding"},
    "frame": {"$ref": "canon.geo.geometry_request.v0.schema.json#/$defs/frame"},
    "points": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["point_id", "source_record", "frame_id", "coordinate"], "properties": {
        "point_id": {"$ref": "#/$defs/id"}, "source_record": {"$ref": "#/$defs/record"},
        "frame_id": {"$ref": "#/$defs/id"}, "coordinate": {"$ref": "canon.geo.geometry_request.v0.schema.json#/$defs/source_point_decimal"}
      }}
    },
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["parcel_id", "source_record", "geometry", "retained_admission_refusal"], "properties": {
        "parcel_id": {"$ref": "#/$defs/id"}, "source_record": {"$ref": "#/$defs/record"},
        "geometry": {"oneOf": [{"type": "null"}, {"$ref": "canon.geo.geometry_request.v0.schema.json#/$defs/feature_input"}]},
        "retained_admission_refusal": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/geometry_error"}]}
      }}
    },
    "acquisition_truncated": {"const": false, "description": "A truncated acquisition must be completed/replanned externally before this path executes."},
    "max_relation_pairs": {"type": "integer", "minimum": 1},
    "max_predicates": {"type": "integer", "minimum": 0},
    "max_vertices_per_geometry": {"type": "integer", "minimum": 1},
    "max_geometry_bytes": {"type": "integer", "minimum": 1},
    "max_report_bytes": {"type": "integer", "minimum": 1},
    "max_assignments": {"type": "integer", "minimum": 0},
    "max_materialized_models": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "blake3": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record": {"$ref": "canon.geo.evidence_request.v0.schema.json#/$defs/evidence_record_ref"},
    "source_transform": {
      "type": "object", "additionalProperties": false,
      "required": ["method_id", "method_version", "parameters_blake3", "source_accuracy_mm"],
      "properties": {"method_id": {"$ref": "#/$defs/id"}, "method_version": {"$ref": "#/$defs/id"}, "parameters_blake3": {"$ref": "#/$defs/blake3"}, "source_accuracy_mm": {"type": ["integer", "null"], "minimum": 0}},
      "description": "Unknown source/control accuracy is null; the frame's exact integer snap audit does not establish source accuracy. Retain the original parameter/source bytes externally."
    },
    "geometry_error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "detail"],
      "properties": {
        "code": {"enum": ["unsupported_version", "invalid_input", "invalid_frame", "invalid_coordinate", "invalid_source_digest", "invalid_source_encoding", "invalid_source_provenance", "invalid_tile_contract", "invalid_license_posture", "malformed_wkb", "unsupported_geometry_type", "mixed_source_execution", "non_finite_coordinate", "source_precision_exceeded", "mixed_crs", "antimeridian_crossing", "empty_geometry", "unclosed_ring", "too_few_vertices", "duplicate_vertex", "degenerate_ring", "self_intersection", "hole_outside_exterior", "polygon_intersection", "vertex_budget_exceeded", "tile_byte_budget_exceeded", "arithmetic_overflow", "serialization"]},
        "message": {"type": "string"}, "detail": {"type": "object", "additionalProperties": {"type": "string"}},
        "budget": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["policy_id", "limit", "enforcement", "observed", "configured"], "properties": {
          "policy_id": {"type": "string"}, "limit": {"enum": ["max_vertices_per_geometry", "max_geometry_bytes_per_tile"]}, "enforcement": {"enum": ["refuse_before_materialization", "refuse_before_output"]}, "observed": {"type": "integer", "minimum": 0}, "configured": {"type": "integer", "minimum": 0}
        }}]}
      }
    }
  }
}
