{
  "$id": "https://cmdrvl.com/schemas/canon.geo.observer_admission_request.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.observer_admission_request.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_observer_admission_request.v0",
      "type": "string"
    },
    "contract": { "$ref": "#/$defs/observer_contract" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation_row" }
    },
    "rho_contracts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rho_contract" }
    },
    "forbidden_license_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "universe": { "$ref": "#/$defs/composition_universe" }
  },
  "required": [
    "version",
    "contract",
    "rows",
    "rho_contracts",
    "forbidden_license_ids",
    "universe"
  ],
  "$defs": {
    "blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "valid_time_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_day": { "type": "integer" },
        "end_day": { "type": "integer" }
      },
      "required": ["start_day", "end_day"]
    },
    "image_tile_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "byte_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        },
        "etag": { "type": "string", "minLength": 1 },
        "blake3": { "$ref": "#/$defs/blake3" },
        "vintage": { "$ref": "#/$defs/valid_time_interval" },
        "license_id": { "type": "string", "minLength": 1 },
        "license_text_blake3": { "$ref": "#/$defs/blake3" },
        "source_dataset": { "type": "string", "minLength": 1 }
      },
      "required": [
        "url",
        "blake3",
        "vintage",
        "license_id",
        "license_text_blake3",
        "source_dataset"
      ]
    },
    "observation_kind": {
      "type": "string",
      "enum": [
        "structure_count_in_window",
        "footprint_outline",
        "height_or_floors",
        "present_at_vintage",
        "absent_at_vintage",
        "change_event"
      ]
    },
    "observation_payload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "structure_count_in_window",
              "type": "string"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          },
          "required": ["kind", "min", "max"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "footprint_outline", "type": "string" },
            "ring_blake3": { "$ref": "#/$defs/blake3" }
          },
          "required": ["kind", "ring_blake3"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "height_or_floors", "type": "string" },
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          },
          "required": ["kind", "min", "max"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "present_at_vintage", "type": "string" },
            "interval": { "$ref": "#/$defs/valid_time_interval" }
          },
          "required": ["kind", "interval"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "absent_at_vintage", "type": "string" },
            "interval": { "$ref": "#/$defs/valid_time_interval" }
          },
          "required": ["kind", "interval"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "change_event", "type": "string" },
            "before": { "$ref": "#/$defs/valid_time_interval" },
            "after": { "$ref": "#/$defs/valid_time_interval" }
          },
          "required": ["kind", "before", "after"]
        }
      ]
    },
    "observation_row": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "observer_id": { "type": "string", "minLength": 1 },
        "tile_pins": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/image_tile_pin" }
        },
        "window_blake3": { "$ref": "#/$defs/blake3" },
        "kind": { "$ref": "#/$defs/observation_kind" },
        "payload": { "$ref": "#/$defs/observation_payload" },
        "crop_blake3": { "$ref": "#/$defs/blake3" },
        "label_blake3": { "$ref": "#/$defs/blake3" }
      },
      "required": [
        "id",
        "observer_id",
        "tile_pins",
        "window_blake3",
        "kind",
        "payload",
        "crop_blake3",
        "label_blake3"
      ]
    },
    "observer_identity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "rule_based", "type": "string" },
            "rule_id": { "type": "string", "minLength": 1 },
            "rule_version": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "rule_id", "rule_version"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "frozen_weight", "type": "string" },
            "model_id": { "type": "string", "minLength": 1 },
            "weight_blake3": { "$ref": "#/$defs/blake3" },
            "arithmetic_contract": { "type": "string", "minLength": 1 }
          },
          "required": [
            "kind",
            "model_id",
            "weight_blake3",
            "arithmetic_contract"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "recorded_hosted", "type": "string" },
            "model_id": { "type": "string", "minLength": 1 },
            "model_version": { "type": "string", "minLength": 1 },
            "prompt_blake3": { "$ref": "#/$defs/blake3" }
          },
          "required": ["kind", "model_id", "model_version", "prompt_blake3"]
        }
      ]
    },
    "observer_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": {
          "const": "canon_geo_observer.v0",
          "type": "string"
        },
        "identity": { "$ref": "#/$defs/observer_identity" },
        "output_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation_kind" }
        },
        "error_population_id": { "type": "string", "minLength": 1 },
        "characterization_blake3": { "$ref": "#/$defs/blake3" },
        "rho_contract_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "id",
        "version",
        "identity",
        "output_kinds",
        "error_population_id",
        "characterization_blake3",
        "rho_contract_ids"
      ]
    },
    "evidence_claim_role": {
      "type": "string",
      "enum": [
        "stable_identity_anchor",
        "temporal_occupancy",
        "lifecycle_event",
        "attribute_observation"
      ]
    },
    "rho_basis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "logical_relaxation", "type": "string" },
            "invariant_id": { "type": "string", "minLength": 1 }
          },
          "required": ["kind", "invariant_id"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "empirical_calibration", "type": "string" },
            "population_id": { "type": "string", "minLength": 1 },
            "calibration_blake3": { "$ref": "#/$defs/blake3" },
            "falsification_rule_id": { "type": "string", "minLength": 1 },
            "admissible_hard_band": { "type": "boolean" }
          },
          "required": [
            "kind",
            "population_id",
            "calibration_blake3",
            "falsification_rule_id"
          ]
        }
      ]
    },
    "rho_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "source_dataset": { "type": "string", "minLength": 1 },
        "source_release": { "type": "string", "minLength": 1 },
        "source_lineage_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "method_id": { "type": "string", "minLength": 1 },
        "method_version": { "type": "string", "minLength": 1 },
        "claim_role": { "$ref": "#/$defs/evidence_claim_role" },
        "basis": { "$ref": "#/$defs/rho_basis" }
      },
      "required": [
        "id",
        "version",
        "source_dataset",
        "source_release",
        "source_lineage_ids",
        "method_id",
        "method_version",
        "claim_role",
        "basis"
      ]
    },
    "building_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parcel_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["id", "parcel_ids"]
    },
    "composition_universe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parcels": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "buildings": {
          "type": "array",
          "items": { "$ref": "#/$defs/building_candidate" }
        }
      },
      "required": ["parcels", "buildings"]
    }
  },
  "x-canon-contract": {
    "runtime_only_invariants": [
      "request rows are sorted by row id before admission and must validate against the observer contract",
      "forbidden_license_ids, rho_contracts, parcels, buildings, and building parcel_ids are canonicalized before replay",
      "admission emits rho observations only through the same rho contract validator used by ordinary evidence classes"
    ]
  }
}
