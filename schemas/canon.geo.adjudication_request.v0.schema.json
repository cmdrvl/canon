{
  "$id": "https://cmdrvl.com/schemas/canon.geo.adjudication_request.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.adjudication_request.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_adjudication_request.v0",
      "type": "string"
    },
    "case_id": { "$ref": "#/$defs/nonempty_string" },
    "subject_id": { "$ref": "#/$defs/nonempty_string" },
    "tile_pin": { "$ref": "#/$defs/image_tile_pin" },
    "window_blake3": { "$ref": "#/$defs/blake3" },
    "candidate_parcel_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonempty_string" }
    },
    "overlay_geometry_blake3": { "$ref": "#/$defs/blake3" }
  },
  "required": [
    "version",
    "case_id",
    "subject_id",
    "tile_pin",
    "window_blake3",
    "candidate_parcel_ids",
    "overlay_geometry_blake3"
  ],
  "$defs": {
    "nonempty_string": { "type": "string", "minLength": 1 },
    "blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "valid_time_interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_day": { "type": "integer" },
        "end_day": { "type": "integer" }
      },
      "required": ["start_day", "end_day"]
    },
    "image_tile_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": { "$ref": "#/$defs/nonempty_string" },
        "byte_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        },
        "etag": { "$ref": "#/$defs/nonempty_string" },
        "blake3": { "$ref": "#/$defs/blake3" },
        "vintage": { "$ref": "#/$defs/valid_time_interval" },
        "license_id": { "$ref": "#/$defs/nonempty_string" },
        "license_text_blake3": { "$ref": "#/$defs/blake3" },
        "source_dataset": { "$ref": "#/$defs/nonempty_string" }
      },
      "required": [
        "url",
        "blake3",
        "vintage",
        "license_id",
        "license_text_blake3",
        "source_dataset"
      ]
    }
  },
  "x-canon-contract": {
    "runtime_only_invariants": [
      "candidate_parcel_ids must be sorted and unique",
      "window_blake3 and overlay_geometry_blake3 bind retained crop/overlay inputs; Canon does not fetch or render imagery during validation"
    ]
  }
}
