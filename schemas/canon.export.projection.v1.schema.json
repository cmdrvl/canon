{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.export.projection.v1.schema.json",
  "title": "canon.export.projection.v1",
  "description": "Domain-neutral extension projection package contract for adding identifier, relation, assignment, provenance, unresolved, and domain-view export tables to dbt seeds and SQLite search artifacts without changing Canon Rust code or exact lookup semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "package_id",
    "package_version",
    "package_digest",
    "registry_snapshot_digest",
    "records",
    "tables"
  ],
  "properties": {
    "version": {
      "const": "canon.export.projection.v1"
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "package_digest": {
      "$ref": "#/$defs/blake3_digest"
    },
    "registry_snapshot_digest": {
      "$ref": "#/$defs/blake3_digest"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_record"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "blake3_digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "safe_identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "safe_field": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "row_kind": {
      "enum": [
        "identity",
        "identifier",
        "relation",
        "assignment",
        "provenance",
        "domain_view",
        "unresolved"
      ]
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "row_kind"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "row_kind": {
          "$ref": "#/$defs/row_kind"
        },
        "canonical_id": {
          "type": "string"
        },
        "relation_id": {
          "type": "string"
        },
        "assignment_id": {
          "type": "string"
        },
        "provenance_ref": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/safe_field"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_name",
        "row_kind",
        "columns"
      ],
      "properties": {
        "table_name": {
          "$ref": "#/$defs/safe_identifier"
        },
        "row_kind": {
          "$ref": "#/$defs/row_kind"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "primary_key": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/safe_identifier"
          }
        },
        "search_fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/search_field"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "column_type",
        "expression"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/safe_identifier"
        },
        "column_type": {
          "enum": [
            "text",
            "integer_text",
            "digest",
            "canonical_id"
          ]
        },
        "expression": {
          "$ref": "#/$defs/expression"
        }
      }
    },
    "search_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_name",
        "column",
        "mode"
      ],
      "properties": {
        "field_name": {
          "$ref": "#/$defs/safe_identifier"
        },
        "column": {
          "$ref": "#/$defs/safe_identifier"
        },
        "mode": {
          "enum": [
            "exact",
            "prefix",
            "text"
          ]
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name"],
          "properties": {
            "type": { "const": "field" },
            "name": { "$ref": "#/$defs/safe_field" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "literal" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "enum": [
                "canonical_id",
                "relation_id",
                "assignment_id",
                "source_record_id",
                "package_digest",
                "registry_snapshot_digest"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "name", "keep_last"],
          "properties": {
            "type": { "const": "redacted_field" },
            "name": { "$ref": "#/$defs/safe_field" },
            "keep_last": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "separator", "parts"],
          "properties": {
            "type": { "const": "concat" },
            "separator": { "type": "string" },
            "parts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "expr"],
          "properties": {
            "type": { "const": "lowercase" },
            "expr": {
              "$ref": "#/$defs/expression"
            }
          }
        }
      ]
    }
  },
  "x-canon-contract": {
    "base_identity_tables_remain_generic": true,
    "relations_and_assignments_do_not_imply_identity": true,
    "raw_sql_expressions": "rejected by compiler; expression language is closed and deterministic",
    "nondeterministic_expressions": "rejected by compiler",
    "all_packages_bind_one_registry_snapshot_digest": true,
    "backend_parity": ["dbt-seed", "search-index"]
  }
}
