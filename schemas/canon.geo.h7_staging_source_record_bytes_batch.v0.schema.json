          ]
        },
        {
          "required": [
            "ROW_CONTRACT",
            "ROW_KIND",
            "GUARD_STATUS",
            "PIP_BLOCK_POPULATION_QUERY_ID",
            "PAYLOAD_CONTRACT",
            "SOURCE_RECORD_CLASS"
