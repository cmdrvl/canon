{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.entity.profile.v1.schema.json",
  "title": "canon.entity.profile.v1",
  "description": "Typed entity profile configuration. Profiles are configuration, not linkage maps, policy bundles, or frozen executable strategies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "profile",
    "version",
    "entity_type",
    "identity_semantics",
    "canonical_type",
    "required_fields",
    "normalized_views",
    "evidence",
    "patch_namespaces",
    "evidence_policy",
    "review_policy",
    "promotion_policy",
    "frozen_executable_strategy"
  ],
  "properties": {
    "kind": {
      "const": "entity-profile"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entity_type": {
      "type": "string",
      "minLength": 1
    },
    "identity_semantics": {
      "type": "string",
      "minLength": 1
    },
    "canonical_type": {
      "type": "string",
      "minLength": 1
    },
    "required_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "normalized_views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/normalized_view"
      }
    },
    "evidence": {
      "$ref": "#/$defs/evidence_lanes"
    },
    "patch_namespaces": {
      "$ref": "#/$defs/patch_namespaces"
    },
    "evidence_policy": {
      "$ref": "#/$defs/evidence_policy_ref"
    },
    "review_policy": {
      "$ref": "#/$defs/review_policy_ref"
    },
    "promotion_policy": {
      "$ref": "#/$defs/promotion_policy_ref"
    },
    "frozen_executable_strategy": {
      "$ref": "#/$defs/frozen_strategy_ref"
    }
  },
  "$defs": {
    "normalized_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operators"
      ],
      "properties": {
        "operators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "operator_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "evidence_lanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support",
        "cannot_link",
        "relation_hints"
      ],
      "properties": {
        "support": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operator_spec"
          }
        },
        "cannot_link": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operator_spec"
          }
        },
        "relation_hints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operator_spec"
          }
        }
      }
    },
    "patch_namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aliases",
        "distinct",
        "relations"
      ],
      "properties": {
        "aliases": {
          "type": "string",
          "minLength": 1
        },
        "distinct": {
          "type": "string",
          "minLength": 1
        },
        "relations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "typed_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "content_hash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "entity-profile",
            "linkage-map",
            "evidence-policy",
            "review-policy",
            "promotion-policy",
            "frozen-executable-strategy"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^blake3:.+"
        }
      }
    },
    "evidence_policy_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/typed_reference"
        },
        {
          "properties": {
            "kind": {
              "const": "evidence-policy"
            }
          }
        }
      ]
    },
    "review_policy_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/typed_reference"
        },
        {
          "properties": {
            "kind": {
              "const": "review-policy"
            }
          }
        }
      ]
    },
    "promotion_policy_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/typed_reference"
        },
        {
          "properties": {
            "kind": {
              "const": "promotion-policy"
            }
          }
        }
      ]
    },
    "frozen_strategy_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/typed_reference"
        },
        {
          "properties": {
            "kind": {
              "const": "frozen-executable-strategy"
            }
          }
        }
      ]
    }
  },
  "x-canon-contract": {
    "separate_contracts": [
      "entity-profile",
      "linkage-map",
      "evidence-policy",
      "review-policy",
      "promotion-policy",
      "frozen-executable-strategy"
    ],
    "wrong_kind_refusal": "canon entity and canon resolve must refuse the wrong typed contract kind instead of treating arbitrary YAML as executable strategy input.",
    "legacy_linkage_yaml_destination": "Existing resolve YAML migrates losslessly by preserving the current field-map vocabulary and adding kind=linkage-map in the typed destination."
  }
}
