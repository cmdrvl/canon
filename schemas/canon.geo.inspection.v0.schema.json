{
  "$id": "https://cmdrvl.com/schemas/canon.geo.inspection.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.inspection.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_inspection.v0",
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "semantic_hash": {
      "$ref": "#/$defs/blake3_digest"
    },
    "plan_ref": {
      "$ref": "#/$defs/run_plan_ref"
    },
    "component_id": {
      "type": "string"
    },
    "recommend_next": {
      "type": "boolean"
    },
    "planes": {
      "$ref": "#/$defs/planes"
    },
    "bounds": {
      "$ref": "#/$defs/bounds"
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "answers": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/answer"
      }
    },
    "compare": {
      "$ref": "#/$defs/delta"
    }
  },
  "required": [
    "version",
    "run_id",
    "semantic_hash",
    "plan_ref",
    "recommend_next",
    "planes",
    "bounds",
    "metrics",
    "answers"
  ],
  "$defs": {
    "blake3_digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "uint64": {
      "type": "integer",
      "minimum": 0
    },
    "run_plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "semantic_hash": {
          "$ref": "#/$defs/blake3_digest"
        },
        "project_id": {
          "type": "string"
        },
        "project_graph_hash": {
          "$ref": "#/$defs/blake3_digest"
        },
        "question_hash": {
          "$ref": "#/$defs/blake3_digest"
        },
        "capabilities_hash": {
          "$ref": "#/$defs/blake3_digest"
        },
        "inventory_planning_hash": {
          "$ref": "#/$defs/blake3_digest"
        },
        "profile_hash": {
          "$ref": "#/$defs/blake3_digest"
        },
        "budget_planning_hash": {
          "$ref": "#/$defs/blake3_digest"
        }
      },
      "required": [
        "plan_id",
        "semantic_hash",
        "project_id",
        "project_graph_hash",
        "question_hash",
        "capabilities_hash",
        "inventory_planning_hash",
        "profile_hash",
        "budget_planning_hash"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "type": "string"
        },
        "binding_id": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string"
        },
        "content_digest": {
          "$ref": "#/$defs/blake3_digest"
        },
        "media_type": {
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        },
        "byte_count": {
          "$ref": "#/$defs/uint64"
        }
      },
      "required": [
        "node_id",
        "binding_id",
        "artifact_id",
        "content_digest",
        "media_type",
        "contract_version",
        "byte_count"
      ]
    },
    "question": {
      "type": "string",
      "enum": [
        "Q1",
        "Q2",
        "Q3",
        "Q4",
        "Q5",
        "Q6",
        "Q7",
        "Q8"
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "unsupported_version",
        "invalid_input",
        "budget_exceeded",
        "arithmetic_overflow",
        "inspect_artifact_missing",
        "inspect_question_unanswerable"
      ]
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string"
        },
        "missing_contract": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "missing_contract"
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {
          "$ref": "#/$defs/question"
        },
        "answer": {
          "type": "string"
        },
        "artifact_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "abstention": {
          "$ref": "#/$defs/abstention"
        }
      },
      "required": [
        "question",
        "answer",
        "artifact_refs"
      ]
    },
    "planes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "availability": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        },
        "candidate_reach": {
          "type": "string"
        },
        "admission": {
          "type": "string"
        },
        "solver_exactness": {
          "type": "string"
        },
        "reconciliation": {
          "type": "string"
        },
        "truth_quality": {
          "type": "string"
        },
        "cost": {
          "type": "string"
        }
      },
      "required": [
        "availability",
        "coverage",
        "candidate_reach",
        "admission",
        "solver_exactness",
        "reconciliation",
        "truth_quality",
        "cost"
      ]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "type": "string"
        },
        "max_component_refs": {
          "$ref": "#/$defs/uint64"
        },
        "component_ref_count": {
          "$ref": "#/$defs/uint64"
        },
        "component_refs_truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "max_component_refs",
        "component_ref_count",
        "component_refs_truncated"
      ]
    },
    "claim_class": {
      "type": "string",
      "enum": [
        "candidate_reach",
        "stable_identity",
        "collateral_composition",
        "temporal_occupancy",
        "lifecycle_state",
        "attribute_band"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "residual_model_count": {
          "$ref": "#/$defs/uint64"
        },
        "artifact_digests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/blake3_digest"
          }
        },
        "backbone_members": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_class": {
          "$ref": "#/$defs/claim_class"
        },
        "proof_class": {
          "type": "string"
        }
      },
      "required": [
        "artifact_digests",
        "backbone_members",
        "contradictions",
        "component_keys",
        "proof_class"
      ]
    },
    "claim_class_change": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/claim_class"
        },
        {
          "$ref": "#/$defs/claim_class"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "components_invalidated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "model_count_before": {
          "$ref": "#/$defs/uint64"
        },
        "model_count_after": {
          "$ref": "#/$defs/uint64"
        },
        "backbone_gained": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backbone_lost": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions_introduced": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contradictions_resolved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_class_changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim_class_change"
          }
        }
      },
      "required": [
        "evidence_added",
        "evidence_removed",
        "components_invalidated",
        "model_count_before",
        "model_count_after",
        "backbone_gained",
        "backbone_lost",
        "contradictions_introduced",
        "contradictions_resolved",
        "claim_class_changes"
      ]
    }
  }
}
