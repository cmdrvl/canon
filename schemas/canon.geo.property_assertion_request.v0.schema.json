{
  "$id": "https://cmdrvl.com/schemas/canon.geo.property_assertion_request.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.property_assertion_request.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_property_assertion_request.v0",
      "type": "string"
    },
    "proof_class": {
      "$ref": "#/$defs/proof_class"
    },
    "blocking_strategy": {
      "$ref": "#/$defs/blocking_strategy"
    },
    "relation_graph_product": {
      "$ref": "#/$defs/relation_graph_product"
    },
    "source_corpus": {
      "$ref": "#/$defs/source_corpus"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/document_assertion"
      }
    },
    "max_assertions": {
      "type": "integer",
      "minimum": 1
    },
    "max_members_per_assertion": {
      "type": "integer",
      "minimum": 1
    },
    "max_pairwise_comparisons": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "proof_class",
    "blocking_strategy",
    "relation_graph_product",
    "source_corpus",
    "assertions",
    "max_assertions",
    "max_members_per_assertion",
    "max_pairwise_comparisons"
  ],
  "$defs": {
    "proof_class": {
      "type": "string",
      "enum": [
        "fixture",
        "retained_artifact",
        "observed_warehouse_snapshot"
      ]
    },
    "blocking_strategy": {
      "type": "string",
      "enum": [
        "document_first_then_geography",
        "tile_local_only"
      ]
    },
    "relation_graph_product": {
      "type": "string",
      "enum": [
        "published_derived_projection",
        "workbench_internal_only"
      ]
    },
    "membership_status": {
      "type": "string",
      "enum": [
        "asserted_member",
        "abstained_membership"
      ]
    },
    "abstention_reason": {
      "type": "string",
      "enum": [
        "membership_unresolved",
        "ambiguous_membership",
        "various_address_requires_annex_a_parse"
      ]
    },
    "entity_level": {
      "type": "string",
      "enum": [
        "poi_unit",
        "building",
        "parcel",
        "property"
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "blake3_uri": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "source_corpus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "$ref": "#/$defs/identifier"
        },
        "corpus_version": {
          "$ref": "#/$defs/identifier"
        },
        "temporal_scope": {
          "$ref": "#/$defs/identifier"
        },
        "native_key_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "required": [
        "corpus_id",
        "corpus_version",
        "temporal_scope",
        "native_key_fields"
      ]
    },
    "source_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_record_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_vintage": {
          "$ref": "#/$defs/identifier"
        },
        "record_blake3": {
          "$ref": "#/$defs/blake3_uri"
        }
      },
      "required": [
        "source_record_id",
        "source_vintage",
        "record_blake3"
      ]
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/entity_level"
        },
        "id": {
          "$ref": "#/$defs/identifier"
        }
      },
      "required": [
        "level",
        "id"
      ]
    },
    "member_assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "#/$defs/entity_ref"
        },
        "tile_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "$ref": "#/$defs/membership_status"
        },
        "abstention_reason": {
          "$ref": "#/$defs/abstention_reason"
        },
        "source_record": {
          "$ref": "#/$defs/source_record"
        }
      },
      "required": [
        "member",
        "tile_id",
        "status",
        "source_record"
      ]
    },
    "document_assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "$ref": "#/$defs/identifier"
        },
        "document_id": {
          "$ref": "#/$defs/identifier"
        },
        "accession": {
          "$ref": "#/$defs/identifier"
        },
        "deal_id": {
          "$ref": "#/$defs/identifier"
        },
        "loan_id": {
          "$ref": "#/$defs/identifier"
        },
        "collateral_set_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_record": {
          "$ref": "#/$defs/source_record"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member_assertion"
          }
        }
      },
      "required": [
        "assertion_id",
        "document_id",
        "accession",
        "deal_id",
        "loan_id",
        "collateral_set_id",
        "source_record",
        "members"
      ]
    }
  },
  "x-canon-contract": {
    "runtime_only_invariants": [
      "blocking_strategy document_first_then_geography is required by runtime validation",
      "tile_local_only is a typed refusal because properties may span tiles",
      "published_derived_projection is required so membership is delivered outside flat registry lookup",
      "abstained members carry a typed abstention_reason and do not become contains relations"
    ]
  }
}
