{
  "$id": "https://cmdrvl.com/schemas/canon.geo.condo_bridge_request.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.condo_bridge_request.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_condo_bridge_request.v0",
      "type": "string"
    },
    "unit_bbl": { "type": "string" },
    "billing_bbl_candidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bin_candidates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "block": { "type": "string" },
    "frame_id": { "type": "string" },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_pin" }
    },
    "parcel_rings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/polygon_mm" }
    },
    "footprint_rings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/polygon_mm" }
    }
  },
  "required": [
    "version",
    "unit_bbl",
    "billing_bbl_candidates",
    "bin_candidates",
    "block",
    "frame_id",
    "source_pins",
    "parcel_rings",
    "footprint_rings"
  ],
  "$defs": {
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_table": { "type": "string" },
        "natural_key": { "type": "string" },
        "source_release": { "type": "string" },
        "release_dt": { "type": "string" },
        "variant": { "type": "string" },
        "source_row_number": { "type": "integer", "minimum": 1 },
        "source_file": { "type": "string" },
        "source_file_field": { "type": "string" },
        "source_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_content_sha256_field": { "type": "string" },
        "parser_version": { "type": "string" },
        "license_terms": { "type": "string" },
        "attribution_text": { "type": "string" }
      },
      "required": [
        "source_table",
        "natural_key",
        "source_release",
        "license_terms",
        "attribution_text"
      ]
    },
    "point_mm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      },
      "required": ["x", "y"]
    },
    "ring_mm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vertices": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/point_mm" }
        }
      },
      "required": ["vertices"]
    },
    "polygon_mm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exterior": { "$ref": "#/$defs/ring_mm" },
        "holes": {
          "type": "array",
          "items": { "$ref": "#/$defs/ring_mm" }
        }
      },
      "required": ["exterior"]
    }
  }
}
