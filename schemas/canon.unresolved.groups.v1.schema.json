{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.unresolved.groups.v1.schema.json",
  "title": "canon.unresolved.groups.v1",
  "description": "Deterministic triage groups for recurring unresolved inbox surfaces. This artifact compresses review work only; it makes no canonical identity assertion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "artifact_content_hash",
    "identity_status",
    "source_inbox_artifact_hash",
    "plan",
    "summary",
    "groups"
  ],
  "properties": {
    "version": {
      "const": "canon.unresolved.groups.v1"
    },
    "artifact_content_hash": {
      "$ref": "#/$defs/blake3"
    },
    "identity_status": {
      "const": "no_identity_assertion"
    },
    "source_inbox_artifact_hash": {
      "$ref": "#/$defs/blake3"
    },
    "plan": {
      "$ref": "#/$defs/grouping_plan"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      }
    }
  },
  "$defs": {
    "blake3": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "event_kind": {
      "type": "string",
      "enum": [
        "exact_lookup",
        "cluster_abstention",
        "link_abstention",
        "candidate_rejected"
      ]
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "no_matching_rule",
        "empty_value",
        "missing_field",
        "null_value",
        "non_scalar_value",
        "ambiguous_candidates",
        "score_below_threshold",
        "budget_exceeded",
        "cannot_link"
      ]
    },
    "field_role": {
      "type": "string",
      "enum": [
        "lookup_input",
        "name_field",
        "anchor_field",
        "context_field",
        "candidate_pair"
      ]
    },
    "surface_fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalizer_id",
        "surface_role",
        "fingerprint"
      ],
      "properties": {
        "normalizer_id": {
          "type": "string",
          "minLength": 1
        },
        "surface_role": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "$ref": "#/$defs/blake3"
        }
      }
    },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1
        },
        "profile_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "namespace_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "source"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "occurrence_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_occurrences",
        "distinct_projects",
        "distinct_runs",
        "distinct_sources"
      ],
      "properties": {
        "total_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_projects": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_runs": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_sources": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "occurrence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_ref",
        "run_ref",
        "source_ref",
        "seen_at"
      ],
      "properties": {
        "project_ref": {
          "type": "string",
          "minLength": 1
        },
        "run_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "record_ref": {
          "type": "string"
        },
        "seen_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "cannot_group_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "left_event_key",
        "right_event_key",
        "reason"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "left_event_key": {
          "$ref": "#/$defs/blake3"
        },
        "right_event_key": {
          "$ref": "#/$defs/blake3"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review_action": {
      "type": "string",
      "enum": [
        "split",
        "merge"
      ]
    },
    "review_patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patch_id",
        "action",
        "member_event_keys",
        "operator_ref",
        "reason",
        "reviewed_at"
      ],
      "properties": {
        "patch_id": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "$ref": "#/$defs/review_action"
        },
        "member_event_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/blake3"
          }
        },
        "operator_ref": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "grouping_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "grouping_surface_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_surface_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cannot_group": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cannot_group_rule"
          }
        },
        "review_patches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_patch"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_groups",
        "total_members",
        "total_occurrences",
        "reviewed_patch_count",
        "by_reason_code",
        "by_field_role"
      ],
      "properties": {
        "total_groups": {
          "type": "integer",
          "minimum": 0
        },
        "total_members": {
          "type": "integer",
          "minimum": 0
        },
        "total_occurrences": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_patch_count": {
          "type": "integer",
          "minimum": 0
        },
        "by_reason_code": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_field_role": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "group_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_kind",
        "reason_code",
        "field_name",
        "field_role",
        "grouping_surface_fingerprints"
      ],
      "properties": {
        "event_kind": {
          "$ref": "#/$defs/event_kind"
        },
        "reason_code": {
          "$ref": "#/$defs/reason_code"
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "field_role": {
          "$ref": "#/$defs/field_role"
        },
        "profile_ref": {
          "$ref": "#/$defs/profile_ref"
        },
        "grouping_surface_fingerprints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface_fingerprint"
          }
        },
        "protected_surface_fingerprints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface_fingerprint"
          }
        },
        "namespace_hints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/namespace_hint"
          }
        },
        "temporal_scope": {
          "$ref": "#/$defs/temporal_scope"
        }
      }
    },
    "group_member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_key",
        "event_kind",
        "reason_code",
        "field_name",
        "field_role",
        "first_seen_at",
        "last_seen_at",
        "occurrence_summary",
        "occurrences"
      ],
      "properties": {
        "event_key": {
          "$ref": "#/$defs/blake3"
        },
        "event_kind": {
          "$ref": "#/$defs/event_kind"
        },
        "reason_code": {
          "$ref": "#/$defs/reason_code"
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "field_role": {
          "$ref": "#/$defs/field_role"
        },
        "first_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen_at": {
          "type": "string",
          "format": "date-time"
        },
        "occurrence_summary": {
          "$ref": "#/$defs/occurrence_summary"
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence_ref"
          }
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "group_key_hashes",
        "hard_boundary_hash",
        "representative_event_key",
        "representative_selection",
        "grouping_keys",
        "member_count",
        "occurrence_summary",
        "members"
      ],
      "properties": {
        "group_id": {
          "$ref": "#/$defs/blake3"
        },
        "group_key_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blake3"
          }
        },
        "hard_boundary_hash": {
          "$ref": "#/$defs/blake3"
        },
        "representative_event_key": {
          "$ref": "#/$defs/blake3"
        },
        "representative_selection": {
          "const": "stable_order:first_seen_at,event_key,field_name"
        },
        "grouping_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group_key"
          }
        },
        "member_count": {
          "type": "integer",
          "minimum": 1
        },
        "occurrence_summary": {
          "$ref": "#/$defs/occurrence_summary"
        },
        "review_patch_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group_member"
          }
        }
      }
    }
  }
}
