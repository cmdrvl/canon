{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.trust.policy.v1.schema.json",
  "title": "canon.trust.policy.v1",
  "description": "Deterministic offline trust policy for Canon package promotion and deployment. It defines accepted signing roots, signer identities, issuers, attestation thresholds, expiry and revocation rules, transparency/offline-root requirements, and the explicit escape hatch for unsigned local workflows. Trust verification supplements semantic package verification; it never replaces package digest and contract validation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "canon.trust.policy.v1" },
    "policy_id": { "type": "string", "minLength": 1 },
    "policy_version": { "type": "string", "minLength": 1 },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/root" }
    },
    "trusted_signers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/signer" }
    },
    "thresholds": {
      "type": "array",
      "items": { "$ref": "#/$defs/threshold" }
    },
    "revocations": {
      "type": "array",
      "items": { "$ref": "#/$defs/revocation" }
    },
    "unsigned_local_workflows": {
      "$ref": "#/$defs/unsignedLocalWorkflows"
    },
    "transparency": {
      "$ref": "#/$defs/transparency"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "roots",
    "trusted_signers",
    "thresholds",
    "revocations",
    "unsigned_local_workflows",
    "transparency"
  ],
  "$defs": {
    "blake3Digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "hexKey32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instant": {
      "type": "string",
      "minLength": 1,
      "description": "RFC3339 UTC timestamp; implementations compare deterministic timestamp strings supplied by the caller and never read ambient time."
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root_id": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "key_hex": { "$ref": "#/$defs/hexKey32" },
        "offline": { "type": "boolean" },
        "valid_from": { "$ref": "#/$defs/instant" },
        "expires_at": { "$ref": "#/$defs/instant" }
      },
      "required": ["root_id", "issuer", "key_id", "key_hex", "offline"]
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signer_id": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "allowed_attestation_kinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "valid_from": { "$ref": "#/$defs/instant" },
        "expires_at": { "$ref": "#/$defs/instant" }
      },
      "required": ["signer_id", "issuer", "key_id", "allowed_attestation_kinds"]
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attestation_kind": { "type": "string", "minLength": 1 },
        "required_signatures": { "type": "integer", "minimum": 1 },
        "accepted_signer_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "require_distinct_issuers": { "type": "boolean" },
        "required_claims": {
          "type": "array",
          "items": {
            "enum": [
              "audit_digest",
              "review_digest",
              "source_digest",
              "promotion_digest"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "attestation_kind",
        "required_signatures",
        "accepted_signer_ids",
        "require_distinct_issuers",
        "required_claims"
      ]
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signer_id": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "revoked_at": { "$ref": "#/$defs/instant" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["revoked_at", "reason"],
      "anyOf": [
        { "required": ["signer_id"] },
        { "required": ["issuer"] },
        { "required": ["key_id"] }
      ]
    },
    "unsignedLocalWorkflows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "boolean" },
        "allowed_package_schemas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "reason": { "type": "string", "minLength": 1 }
      },
      "required": ["allow", "allowed_package_schemas", "reason"]
    },
    "transparency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["offline_roots_only", "require_log_digest"]
        },
        "required_log_digest": { "$ref": "#/$defs/blake3Digest" }
      },
      "required": ["mode"]
    }
  },
  "x-canon-contract": {
    "semantic_package_verification_required": true,
    "unsigned_local_workflows": "fail-closed unless unsigned_local_workflows.allow is true and the package schema is listed",
    "ambient_network_policy": "no network is required or trusted by the schema; transparency evidence is passed as pinned digests",
    "receipt_determinism": "verification time and all trust material are explicit inputs"
  }
}
