{
  "$id": "https://cmdrvl.com/schemas/canon.geo.next_evidence.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.next_evidence.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_next_evidence.v0",
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^canon_geo_next_evidence\\.v0:[0-9a-f]{64}$"
    },
    "subject_ref": {
      "$ref": "#/$defs/subject_ref"
    },
    "composition_blake3": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "separation_blake3": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "frontier": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    },
    "dominated": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/next_action"
      }
    },
    "total_ranking": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "ranking_abstention": {
      "$ref": "#/$defs/ranking_abstention"
    },
    "stop": {
      "$ref": "#/$defs/stop_reason"
    },
    "budget_remaining": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "dominance_basis": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dominance_basis"
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "version",
    "run_id",
    "composition_blake3",
    "separation_blake3",
    "frontier",
    "dominated"
  ],
  "$defs": {
    "subject_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accession": {
          "type": "string"
        },
        "loan_id": {
          "type": "string"
        },
        "subject_id": {
          "type": "string"
        }
      },
      "required": [
        "accession",
        "loan_id",
        "subject_id"
      ]
    },
    "next_action_class": {
      "type": "string",
      "enum": [
        "repair_reach",
        "diagnose_conflict",
        "separate_residual",
        "raise_claim_class",
        "stop"
      ]
    },
    "stop_reason": {
      "type": "string",
      "enum": [
        "claim_forced",
        "all_actions_redundant",
        "grain_unsupported",
        "honest_ambiguity",
        "budget_exceeded"
      ]
    },
    "dominance_basis": {
      "type": "string",
      "enum": [
        "exact",
        "bounds"
      ]
    },
    "error_code": {
      "type": "string",
      "enum": [
        "unsupported_version",
        "invalid_input",
        "budget_exceeded",
        "arithmetic_overflow",
        "next_evidence_no_loss_model"
      ]
    },
    "next_action_kind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "acquire",
            "adjudicate",
            "observe",
            "stop"
          ]
        },
        "payload": true
      },
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "acquire"
            },
            "payload": {
              "$ref": "canon.geo.acquisition_request.v0.schema.json"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "adjudicate"
            },
            "payload": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "observe"
            },
            "payload": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "payload"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "stop"
            }
          },
          "required": [
            "kind"
          ],
          "not": {
            "required": [
              "payload"
            ]
          }
        }
      ]
    },
    "outcome_separation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome_id": {
          "type": "string"
        },
        "residual_model_count": {
          "type": "integer",
          "minimum": 0
        },
        "count_exact": {
          "type": "boolean"
        }
      },
      "required": [
        "outcome_id",
        "residual_model_count",
        "count_exact"
      ]
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/next_action_class"
        },
        "kind": {
          "$ref": "#/$defs/next_action_kind"
        },
        "observation_id": {
          "type": "string"
        },
        "cost_units": {
          "type": "integer",
          "minimum": 0
        },
        "separation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outcome_separation"
          }
        },
        "worst_case_remaining": {
          "type": "integer",
          "minimum": 0
        },
        "redundant": {
          "type": "boolean"
        },
        "lineage_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dominated_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "stop_reason": {
          "$ref": "#/$defs/stop_reason"
        }
      },
      "required": [
        "action_id",
        "class",
        "kind",
        "cost_units",
        "separation",
        "worst_case_remaining",
        "redundant"
      ]
    },
    "ranking_abstention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/error_code"
        },
        "message": {
          "type": "string"
        },
        "detail": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "code",
        "message",
        "detail"
      ]
    }
  },
  "x-canon-contract": {
    "runtime_only_invariants": [
      "frontier contains nondominated current actions under exact pairwise dominance",
      "dominance_basis marks inexact comparisons as bounds; bounds never creates dominated_by",
      "total_ranking is present only when the request policy carries a loss_model"
    ]
  }
}
