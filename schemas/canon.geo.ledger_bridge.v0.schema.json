{
  "$id": "https://cmdrvl.com/schemas/canon.geo.ledger_bridge.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.ledger_bridge.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_ledger_bridge.v0",
      "type": "string"
    },
    "unit_bbl": { "type": "string" },
    "billing_bbl": { "type": "string" },
    "bins": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confirmation": {
      "type": "string",
      "enum": ["block_and_geometry", "block_only", "key_only"]
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation_tuple" }
    },
    "source_pins": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source_pin" }
    },
    "abstained_reason": { "type": "string" }
  },
  "required": [
    "version",
    "unit_bbl",
    "bins",
    "confirmation",
    "relations",
    "source_pins"
  ],
  "$defs": {
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_table": { "type": "string" },
        "natural_key": { "type": "string" },
        "source_release": { "type": "string" },
        "release_dt": { "type": "string" },
        "variant": { "type": "string" },
        "source_row_number": { "type": "integer", "minimum": 1 },
        "source_file": { "type": "string" },
        "source_file_field": { "type": "string" },
        "source_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_content_sha256_field": { "type": "string" },
        "parser_version": { "type": "string" },
        "license_terms": { "type": "string" },
        "attribution_text": { "type": "string" }
      },
      "required": [
        "source_table",
        "natural_key",
        "source_release",
        "license_terms",
        "attribution_text"
      ]
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "type": "string",
          "enum": ["poi_unit", "building", "parcel", "property"]
        },
        "id": { "type": "string" }
      },
      "required": ["level", "id"]
    },
    "identity_relation": {
      "type": "string",
      "enum": ["same_as", "contains", "part_of", "within", "on"]
    },
    "relation_tuple": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/entity_ref" },
        { "$ref": "#/$defs/identity_relation" },
        { "$ref": "#/$defs/entity_ref" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
