{
  "$id": "https://cmdrvl.com/schemas/canon.geo.name_region_resolution.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.name_region_resolution.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_name_region_resolution.v0",
      "type": "string"
    },
    "resolution_id": {
      "type": "string",
      "pattern": "^canon_geo_name_region_resolution\\.v0:[0-9a-f]{64}$"
    },
    "source_corpus": { "$ref": "#/$defs/source_corpus" },
    "proof_class": { "$ref": "#/$defs/proof_class" },
    "build_receipts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/build_receipt" }
    },
    "release_claim_allowed": { "const": false, "type": "boolean" },
    "region": { "$ref": "#/$defs/bounded_geography" },
    "requested_entity_level": { "$ref": "#/$defs/entity_level" },
    "requested_claim_classes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/claim_class" }
    },
    "source_pins": {
      "type": "array",
      "items": { "$ref": "#/$defs/source_pin" }
    },
    "region_cell_coverage": { "$ref": "#/$defs/cell_coverage" },
    "subject": { "$ref": "#/$defs/subject" },
    "status": { "$ref": "#/$defs/status" },
    "reason": { "$ref": "#/$defs/reason" },
    "regional_rarity": { "$ref": "#/$defs/rarity_report" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate_report" }
    },
    "selected_sets": {
      "type": "array",
      "items": { "$ref": "#/$defs/resolved_set" }
    },
    "refusals": {
      "type": "array",
      "items": { "$ref": "#/$defs/refusal" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "required": [
    "version",
    "resolution_id",
    "source_corpus",
    "proof_class",
    "build_receipts",
    "release_claim_allowed",
    "region",
    "requested_entity_level",
    "requested_claim_classes",
    "source_pins",
    "region_cell_coverage",
    "subject",
    "status",
    "reason",
    "regional_rarity",
    "candidates",
    "selected_sets",
    "refusals",
    "summary"
  ],
  "$defs": {
    "string": { "type": "string", "minLength": 1 },
    "blake3_uri": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "entity_level": {
      "type": "string",
      "enum": ["site", "property", "parcel", "building", "unit", "address", "poi"]
    },
    "claim_class": {
      "type": "string",
      "enum": [
        "candidate_reach",
        "stable_identity",
        "collateral_composition",
        "temporal_occupancy",
        "lifecycle_state",
        "attribute_band"
      ]
    },
    "source_corpus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "corpus_id": { "$ref": "#/$defs/string" },
        "corpus_kind": {
          "type": "string",
          "enum": [
            "cmbs_annex_a",
            "hud_fha",
            "fannie_freddie",
            "ginnie_pool_no_address",
            "reit_schedule_iii_name_only",
            "naic_descriptor",
            "unknown"
          ]
        },
        "corpus_version": { "$ref": "#/$defs/string" },
        "temporal_scope": { "$ref": "#/$defs/string" },
        "native_key_fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        }
      },
      "required": [
        "corpus_id",
        "corpus_kind",
        "corpus_version",
        "temporal_scope",
        "native_key_fields"
      ]
    },
    "proof_class": {
      "type": "string",
      "enum": ["live_query", "retained_artifact", "fixture"]
    },
    "build_receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "receipt_id": { "$ref": "#/$defs/string" },
        "query_id": { "$ref": "#/$defs/string" },
        "source_artifact_blake3": { "$ref": "#/$defs/blake3_uri" },
        "row_count": { "type": "integer", "minimum": 0 },
        "run_status": {
          "type": "string",
          "enum": ["completed", "cancelled"]
        }
      },
      "required": [
        "receipt_id",
        "query_id",
        "source_artifact_blake3",
        "row_count",
        "run_status"
      ]
    },
    "bounded_geography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geography_id": { "$ref": "#/$defs/string" },
        "geography_kind": { "$ref": "#/$defs/string" },
        "description": { "$ref": "#/$defs/string" }
      },
      "required": ["geography_id", "geography_kind", "description"]
    },
    "source_role": {
      "type": "string",
      "enum": [
        "region_cell_coverage",
        "name_bearing_entity",
        "descent_relation",
        "attribute_confirmation"
      ]
    },
    "license_class": {
      "type": "string",
      "enum": [
        "public_redistributable",
        "public_attribution_required",
        "restricted_local_only",
        "unknown"
      ]
    },
    "egress_class": {
      "type": "string",
      "enum": ["shareable", "derived_only", "local_only", "unknown"]
    },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_instance_id": { "$ref": "#/$defs/string" },
        "role": { "$ref": "#/$defs/source_role" },
        "release_id": { "$ref": "#/$defs/string" },
        "release_digest": { "$ref": "#/$defs/blake3_uri" },
        "local_artifact_id": { "$ref": "#/$defs/string" },
        "local_content_hash": { "$ref": "#/$defs/blake3_uri" },
        "license_class": { "$ref": "#/$defs/license_class" },
        "egress_class": { "$ref": "#/$defs/egress_class" }
      },
      "required": [
        "source_instance_id",
        "role",
        "release_id",
        "release_digest",
        "local_artifact_id",
        "local_content_hash",
        "license_class",
        "egress_class"
      ]
    },
    "coverage_basis": {
      "type": "string",
      "enum": [
        "administrative_boundary_cells",
        "zip_boundary_cells",
        "operator_declared_cells"
      ]
    },
    "cell_coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_id": { "$ref": "#/$defs/string" },
        "source_instance_id": { "$ref": "#/$defs/string" },
        "source_record_id": { "$ref": "#/$defs/string" },
        "source_record_blake3": { "$ref": "#/$defs/blake3_uri" },
        "basis": { "$ref": "#/$defs/coverage_basis" },
        "h3_cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        }
      },
      "required": [
        "coverage_id",
        "source_instance_id",
        "source_record_id",
        "source_record_blake3",
        "basis",
        "h3_cells"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row_id": { "$ref": "#/$defs/string" },
        "source_record_id": { "$ref": "#/$defs/string" },
        "source_record_blake3": { "$ref": "#/$defs/blake3_uri" },
        "asserted_name": { "$ref": "#/$defs/string" },
        "asserted_region": { "$ref": "#/$defs/string" },
        "asserted_property_type": { "$ref": "#/$defs/string" },
        "asserted_year_built": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "row_id",
        "source_record_id",
        "source_record_blake3",
        "asserted_name",
        "asserted_region"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["resolved", "abstained", "refused"]
    },
    "reason": {
      "type": "string",
      "enum": [
        "unique_name_region_match_descended_to_supported_grain",
        "no_name_match_in_region",
        "non_discriminating_name_in_region",
        "ambiguous_name_matches_in_region",
        "attribute_disagreement_at_confirm_step",
        "missing_region_boundary",
        "missing_pinned_name_bearing_source",
        "missing_source_license_pins",
        "no_descent_path_to_supported_grain",
        "parcel_grain_requested_without_parcel_inventory",
        "unsupported_requested_grain",
        "unsupported_corpus_kind"
      ]
    },
    "rarity_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_id": { "$ref": "#/$defs/string" },
        "region_candidate_count": { "type": "integer", "minimum": 0 },
        "name_matched_candidate_count": { "type": "integer", "minimum": 0 },
        "max_name_matches_for_resolution": { "type": "integer", "minimum": 0 },
        "min_name_score_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "chain_review_min_matches": { "type": "integer", "minimum": 0 },
        "discriminating_in_region": { "type": "boolean" }
      },
      "required": [
        "policy_id",
        "region_candidate_count",
        "name_matched_candidate_count",
        "max_name_matches_for_resolution",
        "min_name_score_basis_points",
        "chain_review_min_matches",
        "discriminating_in_region"
      ]
    },
    "candidate_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_id": { "$ref": "#/$defs/string" },
        "entity_level": { "$ref": "#/$defs/entity_level" },
        "display_name": { "$ref": "#/$defs/string" },
        "source_instance_id": { "$ref": "#/$defs/string" },
        "in_region": { "type": "boolean" },
        "name_matched": { "type": "boolean" },
        "best_name_score_basis_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "region_cell_overlap_count": { "type": "integer", "minimum": 0 },
        "hard_attribute_failures": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        },
        "selected": { "type": "boolean" }
      },
      "required": [
        "candidate_id",
        "entity_level",
        "display_name",
        "source_instance_id",
        "in_region",
        "name_matched",
        "best_name_score_basis_points",
        "region_cell_overlap_count",
        "hard_attribute_failures",
        "selected"
      ]
    },
    "resolved_set": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_level": { "$ref": "#/$defs/entity_level" },
        "entity_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        },
        "source_candidate_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/string" }
        },
        "representation": { "$ref": "#/$defs/string" }
      },
      "required": [
        "entity_level",
        "entity_ids",
        "source_candidate_ids",
        "representation"
      ]
    },
    "refusal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": { "$ref": "#/$defs/reason" },
        "detail": { "$ref": "#/$defs/string" },
        "requested_entity_level": { "$ref": "#/$defs/entity_level" }
      },
      "required": ["reason", "detail"]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_rows": { "type": "integer", "minimum": 0 },
        "resolved_rows": { "type": "integer", "minimum": 0 },
        "abstained_rows": { "type": "integer", "minimum": 0 },
        "refused_rows": { "type": "integer", "minimum": 0 },
        "region_cells": { "type": "integer", "minimum": 0 },
        "region_candidates": { "type": "integer", "minimum": 0 },
        "name_matched_candidates": { "type": "integer", "minimum": 0 },
        "selected_candidates": { "type": "integer", "minimum": 0 },
        "resolved_entity_sets": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "input_rows",
        "resolved_rows",
        "abstained_rows",
        "refused_rows",
        "region_cells",
        "region_candidates",
        "name_matched_candidates",
        "selected_candidates",
        "resolved_entity_sets"
      ]
    }
  }
}
