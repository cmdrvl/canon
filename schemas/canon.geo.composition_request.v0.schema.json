{
  "$id": "https://cmdrvl.com/schemas/canon.geo.composition_request.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.composition_request.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_composition_request.v0",
      "type": "string"
    },
    "profile": {
      "$ref": "#/$defs/composition_profile"
    },
    "universe": {
      "$ref": "#/$defs/universe"
    },
    "hard_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hard_constraint"
      }
    },
    "soft_preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/soft_preference"
      }
    },
    "max_assignments": {
      "type": "integer",
      "minimum": 0
    },
    "max_materialized_models": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "universe",
    "hard_constraints",
    "soft_preferences",
    "max_assignments",
    "max_materialized_models"
  ],
  "$defs": {
    "entity_level": {
      "type": "string",
      "enum": [
        "poi_unit",
        "building",
        "parcel",
        "property"
      ]
    },
    "entity_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/entity_level"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "level",
        "id"
      ]
    },
    "composition_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "canon_geo_composition_profile.v0",
          "type": "string"
        },
        "selection_level": {
          "$ref": "#/$defs/entity_level"
        },
        "client_input_contract": {
          "$ref": "#/$defs/client_input_contract"
        }
      },
      "required": [
        "version",
        "selection_level"
      ]
    },
    "client_input_field": {
      "type": "string",
      "enum": [
        "geocode",
        "address",
        "geometry",
        "building_size",
        "year_built",
        "property_type"
      ]
    },
    "client_input_presence": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "present_but_unreliable"
      ]
    },
    "client_input_declaration": {
      "type": "string",
      "enum": [
        "lat_lon",
        "accuracy_tier_status",
        "raw_address_string",
        "parsed_components_when_available",
        "locale",
        "geometry_kind",
        "coordinate_reference_system",
        "vendor",
        "vintage",
        "geometry_fidelity",
        "numeric_value",
        "unit",
        "size_measure",
        "conversion_posture",
        "integer_year",
        "sentinel_policy",
        "source_category",
        "neutral_category_mapping",
        "mapping_profile"
      ]
    },
    "client_input_channel_role": {
      "type": "string",
      "enum": [
        "geometry_driver",
        "address_membership",
        "attribute_rejector",
        "assemblage_constraint",
        "diagnostic_only"
      ]
    },
    "client_decision_band": {
      "type": "string",
      "enum": [
        "hard_forced_candidate",
        "exact_residual_or_soft_ranked",
        "abstain_reacquire",
        "unsupported_or_waiting_for_input"
      ]
    },
    "client_disagreement_effect": {
      "type": "string",
      "enum": [
        "reject_candidate",
        "prune_assemblage_member",
        "abstain_reacquire",
        "report_unsupported"
      ]
    },
    "client_input_fixture_kind": {
      "type": "string",
      "enum": [
        "fully_populated",
        "address_only",
        "geometry_only",
        "ginnie_native_no_address_no_geocode"
      ]
    },
    "client_input_field_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/client_input_field"
        },
        "presence_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_input_presence"
          }
        },
        "required_when_present": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_input_declaration"
          }
        },
        "channel_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_input_channel_role"
          }
        },
        "absent_semantics": {
          "type": "string"
        },
        "unreliable_semantics": {
          "type": "string"
        },
        "missing_declaration_refusal": {
          "type": "string"
        }
      },
      "required": [
        "field",
        "presence_modes",
        "required_when_present",
        "channel_roles",
        "absent_semantics",
        "unreliable_semantics",
        "missing_declaration_refusal"
      ]
    },
    "client_channel_decision_band": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "band": {
          "$ref": "#/$defs/client_decision_band"
        },
        "minimum_reliable_agreements": {
          "type": "integer",
          "minimum": 0
        },
        "required_reliable_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_input_field"
          }
        },
        "disagreement_effect": {
          "$ref": "#/$defs/client_disagreement_effect"
        },
        "output_semantics": {
          "type": "string"
        }
      },
      "required": [
        "band",
        "minimum_reliable_agreements",
        "required_reliable_channels",
        "disagreement_effect",
        "output_semantics"
      ]
    },
    "client_channel_agreement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "candidate_universe_rule": {
          "type": "string"
        },
        "independent_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_input_field"
          }
        },
        "channel_sum_forbidden": {
          "type": "boolean"
        },
        "available_disagreement_stronger_than_missing": {
          "type": "boolean"
        },
        "decision_bands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_channel_decision_band"
          }
        }
      },
      "required": [
        "rule_id",
        "candidate_universe_rule",
        "independent_channels",
        "channel_sum_forbidden",
        "available_disagreement_stronger_than_missing",
        "decision_bands"
      ]
    },
    "client_fixture_field_presence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/client_input_field"
        },
        "presence": {
          "$ref": "#/$defs/client_input_presence"
        }
      },
      "required": [
        "field",
        "presence"
      ]
    },
    "client_input_conformance_fixture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixture_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/client_input_fixture_kind"
        },
        "field_presence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_fixture_field_presence"
          }
        },
        "expected_band": {
          "$ref": "#/$defs/client_decision_band"
        }
      },
      "required": [
        "fixture_id",
        "kind",
        "field_presence",
        "expected_band"
      ]
    },
    "client_input_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "field_contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_input_field_contract"
          }
        },
        "channel_agreement": {
          "$ref": "#/$defs/client_channel_agreement"
        },
        "conformance_fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/client_input_conformance_fixture"
          }
        }
      },
      "required": [
        "profile_template_id",
        "template_version",
        "scope",
        "field_contracts",
        "channel_agreement",
        "conformance_fixtures"
      ]
    },
    "building_candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parcel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "parcel_ids"
      ]
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parcels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "buildings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/building_candidate"
          }
        }
      },
      "required": [
        "parcels",
        "buildings"
      ]
    },
    "integer_member_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "integer_measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "semantic_id": { "type": "string" },
        "unit": { "type": "string" },
        "value_origin": {
          "type": "string",
          "enum": ["source_asserted", "exact_derived"]
        }
      },
      "required": ["semantic_id", "unit", "value_origin"]
    },
    "hard_constraint_kind": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "require"
            },
            "member": {
              "$ref": "#/$defs/entity_ref"
            }
          },
          "required": [
            "kind",
            "member"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "forbid"
            },
            "member": {
              "$ref": "#/$defs/entity_ref"
            }
          },
          "required": [
            "kind",
            "member"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cardinality"
            },
            "level": {
              "$ref": "#/$defs/entity_level"
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "level",
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "allowed_sets"
            },
            "level": {
              "$ref": "#/$defs/entity_level"
            },
            "sets": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": [
            "kind",
            "level",
            "sets"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "any_of"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entity_ref"
              }
            }
          },
          "required": [
            "kind",
            "members"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "integer_sum_band"
            },
            "level": {
              "$ref": "#/$defs/entity_level"
            },
            "measure": {
              "$ref": "#/$defs/integer_measure"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/integer_member_value"
              }
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "level",
            "measure",
            "values",
            "min",
            "max"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "all_or_none"
            },
            "members": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/entity_ref"
              }
            }
          },
          "required": [
            "kind",
            "members"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "requires"
            },
            "if_member": {
              "$ref": "#/$defs/entity_ref"
            },
            "then_member": {
              "$ref": "#/$defs/entity_ref"
            }
          },
          "required": [
            "kind",
            "if_member",
            "then_member"
          ]
        }
      ]
    },
    "hard_constraint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "constraint": {
          "$ref": "#/$defs/hard_constraint_kind"
        }
      },
      "required": [
        "id",
        "constraint"
      ]
    },
    "soft_preference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "member": {
          "$ref": "#/$defs/entity_ref"
        },
        "cost_if_absent": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "member",
        "cost_if_absent"
      ]
    }
  }
}
