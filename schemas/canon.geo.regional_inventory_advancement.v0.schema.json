{
  "$id": "https://cmdrvl.com/schemas/canon.geo.regional_inventory_advancement.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.regional_inventory_advancement.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_regional_inventory_advancement.v0",
      "type": "string"
    },
    "advancement_id": {
      "type": "string",
      "pattern": "^canon_geo_regional_inventory_advancement\\.v0:[0-9a-f]{64}$"
    },
    "semantic_hash": { "$ref": "#/$defs/blake3_digest" },
    "effect": { "const": "local_availability_only", "type": "string" },
    "plan_id": {
      "type": "string",
      "pattern": "^canon_geo_plan\\.v0:[0-9a-f]{64}$"
    },
    "plan_semantic_hash": { "$ref": "#/$defs/blake3_digest" },
    "request_id": {
      "type": "string",
      "pattern": "^canon_geo_acquisition_request\\.v0:[0-9a-f]{64}$"
    },
    "request_semantic_hash": { "$ref": "#/$defs/blake3_digest" },
    "base_inventory_id": { "type": "string", "minLength": 1 },
    "base_inventory_semantic_hash": { "$ref": "#/$defs/blake3_digest" },
    "advanced_inventory_id": { "type": "string", "minLength": 1 },
    "advanced_inventory_semantic_hash": { "$ref": "#/$defs/blake3_digest" },
    "bounded_geography": { "$ref": "#/$defs/bounded_geography" },
    "bounded_subset": { "$ref": "#/$defs/bounded_subset" },
    "bounded_subset_hash": { "$ref": "#/$defs/blake3_digest" },
    "receipt_file": { "$ref": "#/$defs/file_audit" },
    "receipt_execution": { "$ref": "#/$defs/receipt_execution" },
    "receipt_terminal_state": { "const": "COMPLETE", "type": "string" },
    "proof_class": { "const": "live", "type": "string" },
    "denominators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/denominator" }
    },
    "source_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "result_digests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "source_advancements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source_advancement" }
    },
    "advanced_inventory": {
      "$ref": "canon.geo.regional_inventory.v1.schema.json"
    }
  },
  "required": [
    "version",
    "advancement_id",
    "semantic_hash",
    "effect",
    "plan_id",
    "plan_semantic_hash",
    "request_id",
    "request_semantic_hash",
    "base_inventory_id",
    "base_inventory_semantic_hash",
    "advanced_inventory_id",
    "advanced_inventory_semantic_hash",
    "bounded_geography",
    "bounded_subset",
    "bounded_subset_hash",
    "receipt_file",
    "receipt_execution",
    "receipt_terminal_state",
    "proof_class",
    "denominators",
    "source_digests",
    "result_digests",
    "source_advancements",
    "advanced_inventory"
  ],
  "$defs": {
    "blake3_digest": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "hashable_digest": {
      "type": "string",
      "pattern": "^(blake3|sha256):[0-9a-f]{64}$|^sha512:[0-9a-f]{128}$"
    },
    "digest_algorithm": {
      "type": "string",
      "enum": ["blake3", "sha256", "sha512"]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "digest_id": { "type": "string", "minLength": 1 },
        "algorithm": { "$ref": "#/$defs/digest_algorithm" },
        "hex_digest": { "type": "string", "pattern": "^[0-9a-f]+$" }
      },
      "required": ["digest_id", "algorithm", "hex_digest"],
      "allOf": [
        {
          "if": {
            "properties": { "algorithm": { "enum": ["blake3", "sha256"] } },
            "required": ["algorithm"]
          },
          "then": {
            "properties": { "hex_digest": { "pattern": "^[0-9a-f]{64}$" } }
          }
        },
        {
          "if": {
            "properties": { "algorithm": { "const": "sha512" } },
            "required": ["algorithm"]
          },
          "then": {
            "properties": { "hex_digest": { "pattern": "^[0-9a-f]{128}$" } }
          }
        }
      ]
    },
    "bounded_geography": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geography_id": { "type": "string", "minLength": 1 },
        "geography_kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "required": ["geography_id", "geography_kind", "description"]
    },
    "subset_predicate_kind": {
      "type": "string",
      "enum": [
        "h3_cells",
        "bounding_box",
        "administrative_boundary",
        "explicit_identifiers",
        "temporal_partition",
        "release_partition"
      ]
    },
    "subset_predicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "predicate_id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/subset_predicate_kind" },
        "expression": { "type": "string", "minLength": 1 }
      },
      "required": ["predicate_id", "kind", "expression"]
    },
    "bounded_subset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subset_id": { "type": "string", "minLength": 1 },
        "geography": { "$ref": "#/$defs/bounded_geography" },
        "h3_cells": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "predicates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/subset_predicate" }
        }
      },
      "required": ["subset_id", "geography", "h3_cells", "predicates"]
    },
    "denominator_source": {
      "type": "string",
      "enum": ["requested_subset", "executor_reported", "result_artifact"]
    },
    "denominator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "denominator_id": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/denominator_source" },
        "count": { "type": "integer", "minimum": 0 },
        "unit": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      },
      "required": ["denominator_id", "source", "count", "unit", "description"]
    },
    "file_audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_id": { "type": "string", "minLength": 1 },
        "byte_count": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/blake3_digest" }
      },
      "required": ["file_id", "byte_count", "digest"]
    },
    "receipt_execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "proof_class": { "const": "live", "type": "string" },
        "terminal_state": { "const": "COMPLETE", "type": "string" },
        "fixture_id": { "type": "string", "minLength": 1 },
        "retained_receipt_id": { "type": "string", "minLength": 1 },
        "executor_request_id": { "type": "string", "minLength": 1 },
        "executor_query_id": { "type": "string", "minLength": 1 },
        "executor_attempt_id": { "type": "string", "minLength": 1 }
      },
      "required": [
        "proof_class",
        "terminal_state",
        "executor_request_id",
        "executor_query_id"
      ],
      "not": {
        "anyOf": [
          { "required": ["fixture_id"] },
          { "required": ["retained_receipt_id"] }
        ]
      }
    },
    "source_availability": {
      "type": "string",
      "enum": ["available", "partial", "missing", "discovery_required", "unreadable"]
    },
    "source_release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_id": { "type": "string", "minLength": 1 },
        "release_digest": { "$ref": "#/$defs/blake3_digest" }
      },
      "required": ["release_id", "release_digest"]
    },
    "local_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "contract_version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(canon_|canon\\.)[A-Za-z0-9_.-]+\\.v[0-9]+$"
        },
        "content_hash": { "$ref": "#/$defs/blake3_digest" },
        "media_type": { "type": "string", "minLength": 1 }
      },
      "required": ["artifact_id", "contract_version", "content_hash", "media_type"]
    },
    "source_advancement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_instance_id": { "type": "string", "minLength": 1 },
        "release": { "$ref": "#/$defs/source_release" },
        "previous_state": { "$ref": "#/$defs/source_availability" },
        "advanced_state": { "const": "available", "type": "string" },
        "local_ref": { "$ref": "#/$defs/local_artifact_ref" },
        "local_artifact_byte_count": { "type": "integer", "minimum": 1 },
        "local_artifact_contract_version": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(canon_|canon\\.)[A-Za-z0-9_.-]+\\.v[0-9]+$"
        },
        "result_digest_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "source_instance_id",
        "release",
        "previous_state",
        "advanced_state",
        "local_ref",
        "local_artifact_byte_count",
        "local_artifact_contract_version",
        "result_digest_ids"
      ]
    }
  }
}
