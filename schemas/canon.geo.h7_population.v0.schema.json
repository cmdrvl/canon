{
  "$id": "https://cmdrvl.com/schemas/canon.geo.h7_population.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.h7_population.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_h7_population.v0",
      "type": "string"
    },
    "rows_version": {
      "const": "canon_geo_h7_population_rows.v0",
      "type": "string"
    },
    "provenance": { "$ref": "canon.geo.h7_population_rows.v0.schema.json#/$defs/provenance" },
    "summary": { "$ref": "#/$defs/summary" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    },
    "population": { "$ref": "canon.geo.population_request.v0.schema.json" }
  },
  "required": [
    "version",
    "rows_version",
    "provenance",
    "summary",
    "cases",
    "population"
  ],
  "$defs": {
    "truth_plane": {
      "type": "string",
      "enum": [
        "non_round_amount_date_legal_borough",
        "round_exact_lender_party"
      ]
    },
    "association_plane": {
      "type": "string",
      "enum": ["single_property", "multi_property"]
    },
    "reach_status": {
      "type": "string",
      "enum": ["full", "partial", "none"]
    },
    "population_scope": {
      "type": "string",
      "enum": ["fixture_subset", "retained_complete", "live_complete"]
    },
    "source_record_role": {
      "type": "string",
      "enum": [
        "bridge_loan",
        "acris_master",
        "acris_legal",
        "acris_party",
        "mappluto_candidate",
        "geocode_diagnostic"
      ]
    },
    "mappluto_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": { "type": "string" },
        "release_dt": { "type": "string" },
        "variant": { "type": "string" },
        "geometry_contract_version": { "type": "string" }
      },
      "required": [
        "release",
        "release_dt",
        "variant",
        "geometry_contract_version"
      ]
    },
    "borough_edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filed_county": { "type": "string" },
        "filed_borough": { "type": "integer", "minimum": 1, "maximum": 5 },
        "legal_borough": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "required": ["filed_county", "filed_borough", "legal_borough"]
    },
    "evidence_record_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_record_id": { "type": "string" },
        "source_vintage": { "type": "string" },
        "record_blake3": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": ["source_record_id", "source_vintage", "record_blake3"]
    },
    "source_evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "$ref": "#/$defs/source_record_role" },
        "parcel_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "source_record": { "$ref": "#/$defs/evidence_record_ref" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": { "enum": ["acris_legal", "mappluto_candidate"] }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "parcel_ids": { "minItems": 1, "maxItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "enum": [
                  "bridge_loan",
                  "acris_master",
                  "acris_party",
                  "geocode_diagnostic"
                ]
              }
            },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "parcel_ids": { "maxItems": 0 }
            }
          }
        }
      ],
      "required": ["role", "parcel_ids", "source_record"]
    },
    "truth_plane_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "truth_plane": { "$ref": "#/$defs/truth_plane" },
        "eligible_loans": { "type": "integer", "minimum": 1 },
        "candidate_loans": { "type": "integer", "minimum": 0 },
        "legal_confirmed_candidate_loans": { "type": "integer", "minimum": 0 },
        "accepted_loans": { "type": "integer", "minimum": 1 },
        "ambiguous_loans": { "type": "integer", "minimum": 0 },
        "candidate_no_legal_confirmation_loans": {
          "type": "integer",
          "minimum": 0
        },
        "no_candidate_loans": { "type": "integer", "minimum": 0 },
        "selected_multi_parcel_loans": { "type": "integer", "minimum": 1 },
        "materialized_case_rows": { "type": "integer", "minimum": 0 },
        "materialized_unique_accepted_loans": { "type": "integer", "minimum": 0 },
        "candidate_reach_full_cases": { "type": "integer", "minimum": 0 },
        "candidate_reach_partial_cases": { "type": "integer", "minimum": 0 },
        "candidate_reach_none_cases": { "type": "integer", "minimum": 0 },
        "truth_parcels": { "type": "integer", "minimum": 0 },
        "candidate_parcels": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "truth_plane",
        "eligible_loans",
        "candidate_loans",
        "legal_confirmed_candidate_loans",
        "accepted_loans",
        "ambiguous_loans",
        "candidate_no_legal_confirmation_loans",
        "no_candidate_loans",
        "selected_multi_parcel_loans",
        "materialized_case_rows",
        "materialized_unique_accepted_loans",
        "candidate_reach_full_cases",
        "candidate_reach_partial_cases",
        "candidate_reach_none_cases",
        "truth_parcels",
        "candidate_parcels"
      ]
    },
    "stratum_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "truth_plane": { "$ref": "#/$defs/truth_plane" },
        "association_plane": { "$ref": "#/$defs/association_plane" },
        "candidate_release": { "$ref": "#/$defs/mappluto_pin" },
        "materialized_case_rows": { "type": "integer", "minimum": 0 },
        "materialized_unique_accepted_loans": { "type": "integer", "minimum": 0 },
        "candidate_reach_full_cases": { "type": "integer", "minimum": 0 },
        "candidate_reach_partial_cases": { "type": "integer", "minimum": 0 },
        "candidate_reach_none_cases": { "type": "integer", "minimum": 0 },
        "truth_parcels": { "type": "integer", "minimum": 0 },
        "candidate_parcels": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "truth_plane",
        "association_plane",
        "candidate_release",
        "materialized_case_rows",
        "materialized_unique_accepted_loans",
        "candidate_reach_full_cases",
        "candidate_reach_partial_cases",
        "candidate_reach_none_cases",
        "truth_parcels",
        "candidate_parcels"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population_scope": { "$ref": "#/$defs/population_scope" },
        "source_rows": { "type": "integer", "minimum": 0 },
        "materialized_case_rows": { "type": "integer", "minimum": 0 },
        "materialized_unique_accepted_loans": { "type": "integer", "minimum": 0 },
        "solver_population_subjects": { "type": "integer", "minimum": 0 },
        "truth_planes": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/truth_plane_summary" }
        },
        "strata": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stratum_summary" }
        }
      },
      "required": [
        "population_scope",
        "source_rows",
        "materialized_case_rows",
        "materialized_unique_accepted_loans",
        "solver_population_subjects",
        "truth_planes",
        "strata"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject_id": { "type": "string" },
        "case_id": { "type": "string" },
        "loan_key": { "type": "string" },
        "document_id": { "type": "string" },
        "truth_plane": { "$ref": "#/$defs/truth_plane" },
        "association_plane": { "$ref": "#/$defs/association_plane" },
        "candidate_release": { "$ref": "#/$defs/mappluto_pin" },
        "property_state": {
          "const": "NY",
          "type": "string"
        },
        "filed_county": { "type": "string" },
        "filed_borough": { "type": "integer", "minimum": 1, "maximum": 5 },
        "legal_borough": { "type": "integer", "minimum": 1, "maximum": 5 },
        "accepted_borough_edges": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/borough_edge" }
        },
        "geocoded_county_fips": { "type": "string" },
        "doc_type": { "type": "string" },
        "originationdate": { "type": "string" },
        "amount_cents": { "type": "integer", "minimum": 1 },
        "is_round_100k_lattice": { "type": "boolean" },
        "originatorname": { "type": "string" },
        "originator_match_text": { "type": "string" },
        "lender_match_text": { "type": "string" },
        "lender_party_type": { "type": "string" },
        "truth_parcels": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        },
        "candidate_parcels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reach_status": { "$ref": "#/$defs/reach_status" },
        "reach_reason": { "type": "string" },
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/source_evidence_record" }
        }
      },
      "required": [
        "subject_id",
        "case_id",
        "loan_key",
        "document_id",
        "truth_plane",
        "association_plane",
        "candidate_release",
        "property_state",
        "filed_county",
        "filed_borough",
        "legal_borough",
        "accepted_borough_edges",
        "doc_type",
        "originationdate",
        "amount_cents",
        "is_round_100k_lattice",
        "truth_parcels",
        "candidate_parcels",
        "reach_status",
        "reach_reason",
        "source_records"
      ]
    }
  }
}
