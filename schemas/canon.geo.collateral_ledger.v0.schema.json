{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.collateral_ledger.v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "proof_class", "rows", "rollups"],
  "properties": {
    "version": {
      "const": "canon_geo_collateral_ledger.v0"
    },
    "proof_class": {
      "$ref": "#/$defs/proof_class"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ledger_row"
      }
    },
    "rollups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deal_rollup"
      }
    }
  },
  "$defs": {
    "proof_class": {
      "type": "string",
      "enum": ["fixture", "retained_artifact", "observed_warehouse_snapshot"]
    },
    "candidate_reach": {
      "type": "string",
      "enum": ["full", "partial", "none"]
    },
    "truth_plane": {
      "type": "string",
      "enum": [
        "gate_v2_historical",
        "non_round_amount_date_legal_borough",
        "round_exact_lender_party",
        "address_derived_control",
        "human_adjudication"
      ]
    },
    "claim_class": {
      "type": "string",
      "enum": [
        "candidate_reach",
        "stable_identity",
        "collateral_composition",
        "temporal_occupancy",
        "lifecycle_state",
        "attribute_band"
      ]
    },
    "composition_status": {
      "type": "string",
      "enum": ["resolved", "ambiguous", "conflict", "budget_fallback"]
    },
    "blake3_uri": {
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "valid_time_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_day", "end_day"],
      "properties": {
        "start_day": {
          "type": "integer"
        },
        "end_day": {
          "type": "integer"
        }
      }
    },
    "source_release_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_dataset", "source_release", "blake3"],
      "properties": {
        "source_dataset": {
          "type": "string",
          "minLength": 1
        },
        "source_release": {
          "type": "string",
          "minLength": 1
        },
        "blake3": {
          "$ref": "#/$defs/blake3_uri"
        }
      }
    },
    "property_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property_id", "parcel_ids", "building_ids"],
      "properties": {
        "property_id": {
          "type": "string",
          "minLength": 1
        },
        "parcel_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "building_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ledger_row": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "version",
        "accession",
        "deal_id",
        "loan_id",
        "reach",
        "claim_class",
        "residual_model_count",
        "count_exact",
        "backbone_complete",
        "source_release_pins",
        "composition_blake3",
        "evidence_blake3",
        "composition_status"
      ],
      "properties": {
        "version": {
          "const": "canon_geo_collateral_ledger.v0"
        },
        "accession": {
          "type": "string",
          "minLength": 1
        },
        "deal_id": {
          "type": "string",
          "minLength": 1
        },
        "loan_id": {
          "type": "string",
          "minLength": 1
        },
        "reach": {
          "$ref": "#/$defs/candidate_reach"
        },
        "reach_none_reason": {
          "type": "string",
          "minLength": 1
        },
        "parcel_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "building_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deed_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "truth_plane": {
          "$ref": "#/$defs/truth_plane"
        },
        "claim_class": {
          "$ref": "#/$defs/claim_class"
        },
        "residual_model_count": {
          "type": "integer",
          "minimum": 0
        },
        "count_exact": {
          "type": "boolean"
        },
        "backbone_complete": {
          "type": "boolean"
        },
        "last_observed_present": {
          "$ref": "#/$defs/valid_time_interval"
        },
        "source_release_pins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_release_pin"
          }
        },
        "composition_blake3": {
          "anyOf": [
            {
              "$ref": "#/$defs/blake3_uri"
            },
            {
              "const": ""
            }
          ]
        },
        "evidence_blake3": {
          "anyOf": [
            {
              "$ref": "#/$defs/blake3_uri"
            },
            {
              "const": ""
            }
          ]
        },
        "ambiguous_parcel_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ambiguous_building_set": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "property_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property_ref"
          }
        },
        "composition_status": {
          "$ref": "#/$defs/composition_status"
        }
      }
    },
    "plane_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolved",
        "ambiguous",
        "conflict",
        "reach_none",
        "budget_fallback"
      ],
      "properties": {
        "resolved": {
          "type": "integer",
          "minimum": 0
        },
        "ambiguous": {
          "type": "integer",
          "minimum": 0
        },
        "conflict": {
          "type": "integer",
          "minimum": 0
        },
        "reach_none": {
          "type": "integer",
          "minimum": 0
        },
        "budget_fallback": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deal_rollup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deal_id", "accession", "rows", "truth_planes"],
      "properties": {
        "deal_id": {
          "type": "string",
          "minLength": 1
        },
        "accession": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "truth_planes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/plane_counts"
          }
        }
      }
    }
  }
}
