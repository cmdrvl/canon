{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmdrvl.com/schemas/canon.geo.home_cell_rows.v0.schema.json",
  "title": "canon.geo.home_cell_rows.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "coordinate_crs",
    "coordinate_decimal_places",
    "h3_resolution",
    "stability_radius_fixed",
    "rows",
    "max_rows"
  ],
  "properties": {
    "version": { "const": "canon_geo_home_cell_rows.v0" },
    "coordinate_crs": { "const": "EPSG:4326" },
    "coordinate_decimal_places": { "type": "integer", "minimum": 0, "maximum": 9 },
    "h3_resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
    "stability_radius_fixed": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/row" }
    },
    "max_rows": { "type": "integer", "minimum": 1, "maximum": 1000000 }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "h3_cell": { "type": "string", "pattern": "^[0-9a-f]{15}$" },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_name",
        "feature_id",
        "source_snapshot",
        "source_record_id",
        "geometry_sha256",
        "representative_point_method",
        "longitude",
        "latitude"
      ],
      "properties": {
        "source_name": { "$ref": "#/$defs/identifier" },
        "feature_id": { "$ref": "#/$defs/identifier" },
        "source_snapshot": { "$ref": "#/$defs/identifier" },
        "source_record_id": { "$ref": "#/$defs/identifier" },
        "geometry_sha256": { "$ref": "#/$defs/sha256" },
        "representative_point_method": { "$ref": "#/$defs/identifier" },
        "longitude": { "type": "string", "minLength": 1 },
        "latitude": { "type": "string", "minLength": 1 },
        "transform_execution_id": { "$ref": "#/$defs/identifier" },
        "transform_definition_id": { "$ref": "#/$defs/identifier" },
        "claimed_home_cell": { "$ref": "#/$defs/h3_cell" }
      }
    }
  }
}
