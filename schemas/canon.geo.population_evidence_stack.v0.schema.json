{
  "$id": "https://cmdrvl.com/schemas/canon.geo.population_evidence_stack.v0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "canon.geo.population_evidence_stack.v0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "canon_geo_population_evidence_stack.v0",
      "type": "string"
    },
    "request_version": {
      "const": "canon_geo_population_evidence_stack_request.v0",
      "type": "string"
    },
    "base_population_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "base_population_provenance": {
      "$ref": "#/$defs/proof_source"
    },
    "overlay_blake3": {
      "$ref": "#/$defs/blake3"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "base_population": {
      "$ref": "canon.geo.population_request.v0.schema.json"
    },
    "request": {
      "$ref": "canon.geo.population_evidence_stack_request.v0.schema.json"
    },
    "population": {
      "$ref": "canon.geo.population_request.v0.schema.json"
    }
  },
  "required": [
    "version",
    "request_version",
    "base_population_blake3",
    "overlay_blake3",
    "summary",
    "base_population",
    "request",
    "population"
  ],
  "$defs": {
    "blake3": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "proof_class": {
      "type": "string",
      "enum": [
        "fixture_subset",
        "observed_snapshot",
        "retained_complete",
        "live_complete"
      ]
    },
    "proof_derivation": {
      "type": "string",
      "enum": [
        "bare_population_request",
        "h7_population_artifact",
        "population_evidence_stack_artifact"
      ]
    },
    "h7_result_mode": {
      "type": "string",
      "enum": [
        "live",
        "observed",
        "replay"
      ]
    },
    "proof_source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "derivation": {
          "$ref": "#/$defs/proof_derivation"
        },
        "proof_class": {
          "$ref": "#/$defs/proof_class"
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "source_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "population_request_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "inherited_source_version": {
          "type": "string",
          "minLength": 1
        },
        "inherited_source_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "h7_population_scope": {
          "$ref": "#/$defs/proof_class"
        },
        "h7_result_mode": {
          "$ref": "#/$defs/h7_result_mode"
        },
        "h7_materialized_unique_accepted_loans": {
          "$ref": "#/$defs/count"
        },
        "h7_solver_population_subjects": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "derivation",
        "proof_class",
        "source_version",
        "source_blake3",
        "population_request_blake3"
      ]
    },
    "case_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "base_evidence_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "stacked_evidence_blake3": {
          "$ref": "#/$defs/blake3"
        },
        "added_contracts": {
          "$ref": "#/$defs/count"
        },
        "reused_contracts": {
          "$ref": "#/$defs/count"
        },
        "added_observations": {
          "$ref": "#/$defs/count"
        },
        "reused_observations": {
          "$ref": "#/$defs/count"
        },
        "added_source_records": {
          "$ref": "#/$defs/count"
        },
        "hard_constraint_observations": {
          "$ref": "#/$defs/count"
        },
        "soft_preference_observations": {
          "$ref": "#/$defs/count"
        },
        "diagnostic_observations": {
          "$ref": "#/$defs/count"
        }
      },
      "required": [
        "case_id",
        "base_evidence_blake3",
        "stacked_evidence_blake3",
        "added_contracts",
        "reused_contracts",
        "added_observations",
        "reused_observations",
        "added_source_records",
        "hard_constraint_observations",
        "soft_preference_observations",
        "diagnostic_observations"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population_cases": {
          "$ref": "#/$defs/count"
        },
        "overlay_cases": {
          "$ref": "#/$defs/count"
        },
        "changed_cases": {
          "$ref": "#/$defs/count"
        },
        "added_contracts": {
          "$ref": "#/$defs/count"
        },
        "reused_contracts": {
          "$ref": "#/$defs/count"
        },
        "added_observations": {
          "$ref": "#/$defs/count"
        },
        "reused_observations": {
          "$ref": "#/$defs/count"
        },
        "added_source_records": {
          "$ref": "#/$defs/count"
        },
        "hard_constraint_observations": {
          "$ref": "#/$defs/count"
        },
        "soft_preference_observations": {
          "$ref": "#/$defs/count"
        },
        "diagnostic_observations": {
          "$ref": "#/$defs/count"
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_summary"
          }
        }
      },
      "required": [
        "population_cases",
        "overlay_cases",
        "changed_cases",
        "added_contracts",
        "reused_contracts",
        "added_observations",
        "reused_observations",
        "added_source_records",
        "hard_constraint_observations",
        "soft_preference_observations",
        "diagnostic_observations",
        "cases"
      ]
    }
  }
}
