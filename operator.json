{
  "schema_version": "operator.v0",
  "name": "canon",
  "version": "0.4.0",
  "description": "Canonical identifier resolution and org-identity orchestration using versioned registries",
  "repository": "https://github.com/cmdrvl/canon",
  "license": "MIT",
  "agent_guide": "https://github.com/cmdrvl/.github/blob/main/profile/AGENT_PROMPT.md",

  "invocation": {
    "binary": "canon",
    "usage": [
      "canon <INPUT> --registry <DIR> --column <COL> [OPTIONS]",
      "canon resolve <REFERENCE_TAPE> <TARGET_TAPE> --strategy <STRATEGY.yaml> --registry <REGISTRY_DIR> [--gold <GOLD.jsonl>] [--write-back] [--emit json|summary] [--max-candidates <N>] [--max-rows <N>] [--max-bytes <N>] [--no-witness]",
      "canon registry build --source <SOURCE> --seed <SEED> --seed-column <COL> --output <DIR> --version <VER> [--incremental] [--max-rows <N>] [--max-bytes <N>] [--batch-size <N>] [--rate-limit-ms <MS>] [--provider-config <KEY=VALUE>]",
      "canon registry diff --old <OLD_DIR> --new <NEW_DIR> [--emit json|summary]",
      "canon registry audit <SEED> --registry <DIR> --column <COL> [--emit json|summary] [--max-rows <N>] [--max-bytes <N>]",
      "canon registry lint <DIR> [--profile standard|org|strategy|auto] [--emit json|summary]",
      "canon strategy profile <INPUT> [--emit json|summary] [--max-rows <N>] [--max-bytes <N>]",
      "canon strategy audit --schema <PROFILE.json> --script <SCRIPT> --suite <DIR> [--emit json|summary]",
      "canon strategy resolve --registry <DIR> --schema <SCHEMA.json> --skill <SKILL.md>|--skill-hash <HASH> [--emit json|summary]",
      "canon strategy register --registry <DIR> --schema <SCHEMA.json> --skill <SKILL.md>|--skill-hash <HASH> --script <SCRIPT> --script-id <ID> --language <LANG> --verify <VERIFY.json> --assess <ASSESS.json> --airlock <AIRLOCK.json> --next-version <VERSION> [--rule-id <RULE>] [--emit json|summary]",
      "canon strategy diff --old <OLD_DIR> --new <NEW_DIR> [--emit json|summary]",
      "canon org run <ROWS> --strategy <STRATEGY.yaml> --registry <REGISTRY_DIR> [--suite <SUITE_DIR>] [--emit json|summary] [--no-witness]",
      "canon org block <ROWS> --strategy <STRATEGY.yaml> --registry <REGISTRY_DIR> [--emit jsonl|summary]",
      "canon org edge <ROWS> --strategy <STRATEGY.yaml> --candidates <BLOCK.jsonl> --registry <REGISTRY_DIR> [--emit jsonl|summary]",
      "canon org solve <ROWS> --strategy <STRATEGY.yaml> --edges <EDGES.jsonl> --registry <REGISTRY_DIR> [--emit json|summary]",
      "canon org audit <RESULT.json> --suite <SUITE_DIR> [--emit json|summary]",
      "canon org promote <RESULT.json> --audit <AUDIT.json> --registry <REGISTRY_DIR> --next-version <VERSION> [--emit json|summary]",
      "canon org review export <RESULT.json> [--emit json|csv] [--include resolved|escrow|contradictions|all]",
      "canon org review import <REVIEW.json|csv> --registry <REGISTRY_DIR> --next-version <VERSION> [--audit <AUDIT.json>] [--emit json|summary]",
      "canon org explain <RESULT.json> --row <SOURCE_ROW_ID>|--canon-id <CANON_ID>|--escrow-id <ESCROW_ID> [--emit json|summary]"
    ],
    "output_mode": "mixed",
    "output_schema": "canon.v0",
    "json_flag": null
  },

  "arguments": [
    {
      "name": "input",
      "type": "file_path",
      "required": true,
      "position": 0,
      "description": "Input CSV or JSONL file. Format detected by extension (.csv, .tsv, .jsonl, .ndjson). Use - for stdin (JSONL only)."
    }
  ],

  "options": [
    { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Registry directory containing registry.json and mapping files" },
    { "name": "column", "flag": "--column", "type": "string", "required": true, "description": "Column containing IDs to resolve" },
    { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (JSON mapping) or csv (CSV with canonical column)" },
    { "name": "canon_column", "flag": "--canon-column", "type": "string", "description": "Name of appended canonical column (default: <COLUMN>__canon). CSV mode only." },
    { "name": "map_out", "flag": "--map-out", "type": "file_path", "description": "Write JSON mapping artifact to file (sidecar). CSV mode only." },
    { "name": "max_rows", "flag": "--max-rows", "type": "integer", "description": "Refuse if input exceeds N data rows" },
    { "name": "max_bytes", "flag": "--max-bytes", "type": "integer", "description": "Refuse if input exceeds N bytes" },
    { "name": "no_witness", "flag": "--no-witness", "type": "flag", "description": "Suppress witness ledger recording" },
    { "name": "explicit", "flag": "--explicit", "type": "flag", "description": "Show entity names and identifiers in JSON output (default: redacted for zero-retention safety)" },
    { "name": "describe", "flag": "--describe", "type": "flag", "description": "Print compiled operator.json and exit 0" },
    { "name": "schema", "flag": "--schema", "type": "flag", "description": "Print canon.v0 JSON Schema and exit 0" },
    { "name": "version", "flag": "--version", "type": "flag", "description": "Print version and exit 0" }
  ],

  "subcommands": [
    {
      "name": "resolve",
      "usage": "canon resolve <REFERENCE_TAPE> <TARGET_TAPE> --strategy <STRATEGY.yaml> --registry <REGISTRY_DIR> [--gold <GOLD.jsonl>] [--write-back] [--emit json|summary] [--max-candidates <N>] [--max-rows <N>] [--max-bytes <N>] [--no-witness]",
      "description": "Run the cross-tape structural resolution workbench and emit canon_resolve.v0 evidence before optional registry write-back",
      "output_mode": "mixed",
      "output_schema": "canon_resolve.v0",
      "status": "implemented",
      "exit_codes": {
        "0": { "meaning": "all target records matched", "domain": "positive" },
        "1": { "meaning": "one or more target records unmatched or ambiguous", "domain": "negative" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "reference_tape", "type": "file_path", "required": true, "position": 0, "description": "Authoritative/reference CSV, TSV, JSONL, or NDJSON tape" },
        { "name": "target_tape", "type": "file_path", "required": true, "position": 1, "description": "Target CSV, TSV, JSONL, or NDJSON tape to match against the reference" },
        { "name": "strategy", "flag": "--strategy", "type": "file_path", "required": true, "description": "Resolve strategy YAML file" },
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Registry used for canon_match lookups and optional write-back" },
        { "name": "gold", "flag": "--gold", "type": "file_path", "description": "Gold cross-reference JSONL file for scoring" },
        { "name": "write_back", "flag": "--write-back", "type": "flag", "description": "Write matched ID pairs to a new registry mapping file after gates pass" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_resolve.v0) or summary" },
        { "name": "max_candidates", "flag": "--max-candidates", "type": "integer", "description": "Refuse if a target record has more than N surviving candidates" },
        { "name": "max_rows", "flag": "--max-rows", "type": "integer", "description": "Refuse if either tape exceeds N data rows" },
        { "name": "max_bytes", "flag": "--max-bytes", "type": "integer", "description": "Refuse if either tape exceeds N bytes" },
        { "name": "no_witness", "flag": "--no-witness", "type": "flag", "description": "Suppress witness ledger recording for canon resolve" }
      ]
    },
    {
      "name": "registry build",
      "usage": "canon registry build --source <SOURCE> --seed <SEED> --seed-column <COL> --output <DIR> --version <VER> [--incremental] [--max-rows <N>] [--max-bytes <N>] [--batch-size <N>] [--rate-limit-ms <MS>] [--provider-config <KEY=VALUE>]",
      "description": "Materialize a standard canon registry directory from a provider-backed seed corpus and write build provenance to _build.json",
      "output_mode": "json",
      "output_schema": "canon_registry_build.v0",
      "exit_codes": {
        "0": { "meaning": "registry materialized successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "source", "flag": "--source", "type": "string", "required": true, "description": "Provider source name" },
        { "name": "seed", "flag": "--seed", "type": "file_path", "required": true, "description": "Seed CSV or JSONL file used to extract unique identifiers" },
        { "name": "seed_column", "flag": "--seed-column", "type": "string", "required": true, "description": "Column containing seed identifiers" },
        { "name": "output", "flag": "--output", "type": "directory_path", "required": true, "description": "Output registry directory to create or update" },
        { "name": "version", "flag": "--version", "type": "string", "required": true, "description": "Registry version to write into registry.json" },
        { "name": "incremental", "flag": "--incremental", "type": "flag", "description": "Carry forward existing registry entries and fetch only new identifiers" },
        { "name": "max_rows", "flag": "--max-rows", "type": "integer", "description": "Refuse if the seed input exceeds N data rows" },
        { "name": "max_bytes", "flag": "--max-bytes", "type": "integer", "description": "Refuse if the seed input exceeds N bytes" },
        { "name": "batch_size", "flag": "--batch-size", "type": "integer", "description": "Override provider batch size" },
        { "name": "rate_limit_ms", "flag": "--rate-limit-ms", "type": "integer", "description": "Override provider rate-limit delay in milliseconds" },
        { "name": "provider_config", "flag": "--provider-config", "type": "string", "description": "Repeatable provider-specific key=value option such as id_type=ID_ISIN or base_url=http://..." }
      ]
    },
    {
      "name": "registry diff",
      "usage": "canon registry diff --old <OLD_DIR> --new <NEW_DIR> [--emit json|summary]",
      "description": "Compare two versions of the same registry and report added, removed, changed, and unchanged effective mappings",
      "output_mode": "mixed",
      "output_schema": "canon_registry_diff.v0",
      "exit_codes": {
        "0": { "meaning": "diff computed successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "old", "flag": "--old", "type": "directory_path", "required": true, "description": "Older registry directory" },
        { "name": "new", "flag": "--new", "type": "directory_path", "required": true, "description": "Newer registry directory" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (structured diff) or summary (human-readable summary line)" }
      ]
    },
    {
      "name": "registry audit",
      "usage": "canon registry audit <SEED> --registry <DIR> --column <COL> [--emit json|summary] [--max-rows <N>] [--max-bytes <N>]",
      "description": "Audit a seed corpus against a registry and report resolved entries, unresolved entries, canonical target counts, and rule-hit counts",
      "output_mode": "mixed",
      "output_schema": "canon_registry_audit.v0",
      "exit_codes": {
        "0": { "meaning": "audit computed successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Registry directory to audit against" },
        { "name": "column", "flag": "--column", "type": "string", "required": true, "description": "Column containing seed identifiers" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (structured audit artifact) or summary (human-readable summary line)" },
        { "name": "max_rows", "flag": "--max-rows", "type": "integer", "description": "Refuse if the seed input exceeds N data rows" },
        { "name": "max_bytes", "flag": "--max-bytes", "type": "integer", "description": "Refuse if the seed input exceeds N bytes" }
      ]
    },
    {
      "name": "registry lint",
      "usage": "canon registry lint <DIR> [--profile standard|org|strategy|auto] [--emit json|summary]",
      "description": "Check standard, org, or strategy registry health without mutating registry files",
      "output_mode": "mixed",
      "output_schema": "canon_registry_lint.v0",
      "exit_codes": {
        "0": { "meaning": "lint report emitted successfully, even when findings are present", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "registry", "type": "directory_path", "required": true, "description": "Registry directory to lint" },
        { "name": "profile", "flag": "--profile", "type": "string", "default": "auto", "description": "Lint profile: standard, org, strategy, or auto" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_registry_lint.v0) or summary" }
      ]
    },
    {
      "name": "strategy profile",
      "usage": "canon strategy profile <INPUT> [--emit json|summary] [--max-rows <N>] [--max-bytes <N>]",
      "description": "Derive a deterministic schema/profile artifact from CSV, TSV, JSONL, or NDJSON input for canon strategy resolve/register",
      "output_mode": "mixed",
      "output_schema": "canon_strategy_profile.v0",
      "exit_codes": {
        "0": { "meaning": "strategy profile emitted successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "input", "type": "file_path", "required": true, "description": "Input CSV, TSV, JSONL, or NDJSON file to profile; use - for JSONL stdin" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_strategy_profile.v0) or summary" },
        { "name": "max_rows", "flag": "--max-rows", "type": "integer", "description": "Refuse if the input exceeds N data rows" },
        { "name": "max_bytes", "flag": "--max-bytes", "type": "integer", "description": "Refuse if the input exceeds N bytes" }
      ]
    },
    {
      "name": "strategy audit",
      "usage": "canon strategy audit --schema <PROFILE.json> --script <SCRIPT> --suite <DIR> [--emit json|summary]",
      "description": "Run a frozen script against deterministic fixture expectations and emit proof fields compatible with strategy register",
      "output_mode": "mixed",
      "output_schema": "canon_strategy_audit.v0",
      "exit_codes": {
        "0": { "meaning": "suite passed and proof artifact emitted", "domain": "positive" },
        "1": { "meaning": "suite ran deterministically but one or more fixtures failed", "domain": "negative" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "schema", "flag": "--schema", "type": "file_path", "required": true, "description": "JSON profile/schema artifact with columns or fields" },
        { "name": "script", "flag": "--script", "type": "file_path", "required": true, "description": "Executable frozen script to audit; fixture bytes are sent on stdin" },
        { "name": "suite", "flag": "--suite", "type": "directory_path", "required": true, "description": "Deterministic fixture suite containing manifest.json and referenced inputs/expected outputs" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_strategy_audit.v0) or summary" }
      ]
    },
    {
      "name": "strategy resolve",
      "usage": "canon strategy resolve --registry <DIR> --schema <SCHEMA.json> --skill <SKILL.md>|--skill-hash <HASH> [--emit json|summary]",
      "description": "Resolve a schema shape plus skill hash to a frozen champion script from a versioned strategy registry",
      "output_mode": "mixed",
      "output_schema": "canon_strategy_resolve.v0",
      "exit_codes": {
        "0": { "meaning": "EXACT or COMPATIBLE frozen script resolved", "domain": "positive" },
        "1": { "meaning": "PARTIAL or UNRESOLVED; escalate for rewrite/registration", "domain": "negative" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Versioned strategy registry directory containing registry.json and _strategy/*.json" },
        { "name": "schema", "flag": "--schema", "type": "file_path", "required": true, "description": "JSON profile/schema artifact with columns or fields" },
        { "name": "skill", "flag": "--skill", "type": "file_path", "description": "Skill file to hash as part of the lookup key" },
        { "name": "skill_hash", "flag": "--skill-hash", "type": "string", "description": "Precomputed skill hash; mutually exclusive with --skill" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_strategy_resolve.v0) or summary" }
      ]
    },
    {
      "name": "strategy register",
      "usage": "canon strategy register --registry <DIR> --schema <SCHEMA.json> --skill <SKILL.md>|--skill-hash <HASH> --script <SCRIPT> --script-id <ID> --language <LANG> --verify <VERIFY.json> --assess <ASSESS.json> --airlock <AIRLOCK.json> --next-version <VERSION> [--rule-id <RULE>] [--emit json|summary]",
      "description": "Register a frozen champion script after verify, assess, and airlock proof artifacts pass",
      "output_mode": "mixed",
      "output_schema": "canon_strategy_register.v0",
      "exit_codes": {
        "0": { "meaning": "strategy entry registered and registry version bumped", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Versioned strategy registry directory to update" },
        { "name": "schema", "flag": "--schema", "type": "file_path", "required": true, "description": "JSON profile/schema artifact with columns or fields" },
        { "name": "skill", "flag": "--skill", "type": "file_path", "description": "Skill file to hash as part of the lookup key" },
        { "name": "skill_hash", "flag": "--skill-hash", "type": "string", "description": "Precomputed skill hash; mutually exclusive with --skill" },
        { "name": "script", "flag": "--script", "type": "file_path", "required": true, "description": "Frozen script file that passed the gates" },
        { "name": "script_id", "flag": "--script-id", "type": "string", "required": true, "description": "Stable frozen script identifier" },
        { "name": "language", "flag": "--language", "type": "string", "required": true, "description": "Script language/runtime label" },
        { "name": "verify", "flag": "--verify", "type": "file_path", "required": true, "description": "Verify artifact with PASS/PASSED/SUCCESS status or passed:true" },
        { "name": "assess", "flag": "--assess", "type": "file_path", "required": true, "description": "Assess artifact with PROCEED decision" },
        { "name": "airlock", "flag": "--airlock", "type": "file_path", "required": true, "description": "Airlock artifact with PASS/PASSED/SEALED/SUCCESS status or sealed:true" },
        { "name": "next_version", "flag": "--next-version", "type": "string", "required": true, "description": "Explicit registry.json version after registration" },
        { "name": "rule_id", "flag": "--rule-id", "type": "string", "description": "Optional rule identifier; default STRATEGY_CHAMPION" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_strategy_register.v0) or summary" }
      ]
    },
    {
      "name": "strategy diff",
      "usage": "canon strategy diff --old <OLD_DIR> --new <NEW_DIR> [--emit json|summary]",
      "description": "Compare two frozen-script strategy registry versions by effective (schema_fingerprint, skill_hash) entries",
      "output_mode": "mixed",
      "output_schema": "canon_strategy_diff.v0",
      "exit_codes": {
        "0": { "meaning": "strategy diff computed successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "old", "flag": "--old", "type": "directory_path", "required": true, "description": "Older strategy registry directory" },
        { "name": "new", "flag": "--new", "type": "directory_path", "required": true, "description": "Newer strategy registry directory" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_strategy_diff.v0) or summary" }
      ]
    },
    {
      "name": "org run",
      "usage": "canon org run <ROWS> --strategy <STRATEGY.yaml> --registry <REGISTRY_DIR> [--suite <SUITE_DIR>] [--emit json|summary] [--no-witness]",
      "description": "Run the full deterministic org-identity flow and emit canon_org_run.v0",
      "output_mode": "mixed",
      "output_schema": "canon_org_run.v0",
      "exit_codes": {
        "0": { "meaning": "org run completed successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "strategy", "flag": "--strategy", "type": "file_path", "required": true, "description": "Org strategy YAML file" },
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Org registry directory" },
        { "name": "suite", "flag": "--suite", "type": "directory_path", "description": "Optional frozen evaluation suite directory" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "json", "description": "Output mode: json (canon_org_run.v0) or summary" },
        { "name": "no_witness", "flag": "--no-witness", "type": "flag", "description": "Suppress witness ledger recording for canon org run" }
      ]
    },
    {
      "name": "org block",
      "usage": "canon org block <ROWS> --strategy <STRATEGY.yaml> --registry <REGISTRY_DIR> [--emit jsonl|summary]",
      "description": "Generate deterministic candidate neighborhoods for org identity",
      "output_mode": "mixed",
      "output_schema": "canon_org_block.v0",
      "exit_codes": {
        "0": { "meaning": "candidate blocks emitted successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "strategy", "flag": "--strategy", "type": "file_path", "required": true, "description": "Org strategy YAML file" },
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Org registry directory" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "jsonl", "description": "Output mode: jsonl (canon_org_block.v0 records) or summary" }
      ]
    },
    {
      "name": "org edge",
      "usage": "canon org edge <ROWS> --strategy <STRATEGY.yaml> --candidates <BLOCK.jsonl> --registry <REGISTRY_DIR> [--emit jsonl|summary]",
      "description": "Generate typed evidence edges for blocked org row pairs",
      "output_mode": "mixed",
      "output_schema": "canon_org_edge.v0",
      "exit_codes": {
        "0": { "meaning": "edge artifact emitted successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "strategy", "flag": "--strategy", "type": "file_path", "required": true, "description": "Org strategy YAML file" },
        { "name": "candidates", "flag": "--candidates", "type": "file_path", "required": true, "description": "canon_org_block.v0 JSONL candidate artifact" },
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Org registry directory" },
        { "name": "emit", "flag": "--emit", "type": "string", "default": "jsonl", "description": "Output mode: jsonl (canon_org_edge.v0 records) or summary" }
      ]
    },
    {
      "name": "org solve",
      "usage": "canon org solve <ROWS> --strategy <STRATEGY.yaml> --edges <EDGES.jsonl> --registry <REGISTRY_DIR> [--emit json|summary]",
      "description": "Solve deterministic org identity assignments from evidence edges",
      "output_mode": "mixed",
      "output_schema": "canon_org_solve.v0",
      "exit_codes": {
        "0": { "meaning": "org solve completed successfully", "domain": "positive" },
        "2": { "meaning": "REFUSAL / CLI error", "domain": "error" }
      },
      "options": [
        { "name": "strategy", "flag": "--strategy", "type": "file_path", "required": true, "description": "Org strategy YAML file" },
        { "name": "edges", "flag": "--edges", "type": "file_path", "required": true, "description": "canon_org_edge.v0 JSONL edge artifact" },
        { "name": "registry", "flag": "--registry", "type": "directory_path", "required": true, "description": "Org registry directory" },
