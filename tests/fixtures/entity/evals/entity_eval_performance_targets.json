{
  "schema_version": "canon.entity.eval_performance_targets.v0",
  "doc": "docs/ENTITY_EVALS_AND_PERFORMANCE.md",
  "run_commands": {
    "contract_ci": [
      "cargo test --test entity_eval_performance_contract -- --nocapture",
      "jq '.' tests/fixtures/entity/evals/entity_eval_performance_targets.json",
      "jq '.' tests/fixtures/entity/cmbs/tenant_sample_benchmark_manifest.json",
      "jq '.' tests/fixtures/entity/regab/sec10d_regab_benchmark_manifest.json"
    ],
    "small_ci_future": [
      "cargo test entity_eval_ci_small -- --nocapture",
      "cargo test entity_perf_ci_small -- --nocapture"
    ],
    "operator_future": [
      "cargo test --ignored cmbs_500k_stress -- --nocapture",
      "cargo test --ignored entity_500k_unique_stress -- --nocapture"
    ],
    "final_guardrails_future": [
      "cargo test entity_registry_mutation_safety -- --nocapture",
      "cargo test entity_explainability_completeness -- --nocapture",
      "cargo test entity_review_golden_artifacts -- --nocapture",
      "cargo test entity_metamorphic_eval -- --nocapture",
      "cargo test entity_runtime_guard -- --nocapture",
      "cargo test --ignored entity_peak_memory -- --nocapture"
    ]
  },
  "scorecard_metrics": [
    {
      "id": "ER-SCORE-001",
      "name": "cluster_and_pairwise_metrics",
      "required_outputs": [
        "pairwise_precision",
        "pairwise_recall",
        "pairwise_f1",
        "cluster_precision",
        "cluster_recall",
        "b_cubed_precision",
        "b_cubed_recall",
        "b_cubed_f1"
      ],
      "gates": {
        "curated_hard_negative_false_merges_max": 0,
        "regab_hierarchy_false_merges_max": 0,
        "must_link_candidate_recall_min": 0.995,
        "small_ci_pairwise_precision_min": 0.995,
        "small_ci_pairwise_recall_min": 0.98
      }
    },
    {
      "id": "ER-SCORE-002",
      "name": "false_merge_weighted_loss",
      "formula": "10.0 * false_merge_rate + 2.0 * false_split_rate + 1.0 * missed_candidate_rate + 0.25 * review_over_budget_rate",
      "gates": {
        "small_ci_weighted_loss_max": 0.02,
        "public_sample_weighted_loss_max_after_calibration": 0.05,
        "hard_negative_false_merge_stop_ship": true
      }
    },
    {
      "id": "ER-ADV-001",
      "name": "adversarial_antimerge_suite",
      "must_cover": [
        "parent_vs_subsidiary",
        "bank_parent_vs_loan_services_division",
        "same_brand_family_different_operator",
        "same_numeric_or_address_token_different_entity",
        "same_root_token_different_legal_entity",
        "tenant_shell_vs_real_tenant",
        "platform_or_category_label",
        "dba_slash_parenthetical_relation"
      ],
      "false_merges_max": 0
    },
    {
      "id": "ER-REVIEW-001",
      "name": "review_queue_quality",
      "required_outputs": [
        "review_group_count",
        "review_rows_covered",
        "review_deals_covered",
        "review_groups_per_1k_raw_rows",
        "duplicate_review_group_rate",
        "review_groups_with_positive_evidence_rate",
        "review_groups_with_antimerge_evidence_rate",
        "review_groups_with_next_action_rate"
      ],
      "gates": {
        "small_ci_duplicate_review_group_rate_max": 0.0,
        "required_next_actions": [
          "alias",
          "distinct",
          "relation",
          "escrow",
          "needs_policy"
        ]
      }
    },
    {
      "id": "ER-PERTURB-001",
      "name": "mutation_and_noise_robustness",
      "deterministic_seed_required": true,
      "must_cover": [
        "case",
        "punctuation",
        "legal_suffix",
        "whitespace",
        "ocr_like_single_character",
        "abbreviation",
        "store_suite_unit_number_noise"
      ]
    },
    {
      "id": "ER-DET-001",
      "name": "determinism_and_batch_equivalence",
      "must_compare": [
        "same_input_twice",
        "row_shuffled_input",
        "different_physical_batch_sizes",
        "cold_cache",
        "warm_cache"
      ],
      "canonical_artifact_match_required": true
    },
    {
      "id": "ER-DIFF-001",
      "name": "legacy_and_baseline_differential_eval",
      "regab_exact_baseline_is_floor": true,
      "allowed_differences": [
        "intentional_improvement",
        "review_required",
        "refusal"
      ]
    },
    {
      "id": "ER-REGISTRY-001",
      "name": "registry_mutation_safety",
      "required_behaviors": [
        "refusal_no_mutation",
        "atomic_promotion_write",
        "idempotent_replay",
        "pre_post_registry_tree_hashes",
        "stale_input_refuses_before_write"
      ],
      "gates": {
        "refusal_mutates_registry": false,
        "failed_write_changes_registry_snapshot": false,
        "same_promotion_second_run_changes_registry": false,
        "pre_post_tree_hash_required": true
      }
    },
    {
      "id": "ER-EXPLAIN-001",
      "name": "explainability_completeness",
      "required_sections_ref": "explainability_contract.required_sections",
      "gates": {
        "auto_merge_requires_support_evidence": true,
        "non_merge_requires_antimerge_or_uncertainty": true,
        "exact_replay_requires_rule_and_snapshot": true,
        "canonical_sort_required": true
      }
    },
    {
      "id": "ER-REVIEW-GOLDEN-001",
      "name": "human_review_golden_artifacts",
      "required_artifacts_ref": "review_golden_contract.required_artifacts",
      "gates": {
        "small_ci_duplicate_review_groups_max": 0,
        "review_summary_generated_from_jsonl": true,
        "expected_actions_importable": true
      }
    },
    {
      "id": "ER-META-001",
      "name": "metamorphic_eval",
      "required_relation_ids": [
        "MR-ROW-SHUFFLE",
        "MR-BATCH-SIZE",
        "MR-DUPLICATE-ROWS",
        "MR-CACHE-STATE",
        "MR-HARMLESS-NOISE",
        "MR-PROFILE-FIREWALL",
        "MR-APPLY-REPLAY-IDEMPOTENCE"
      ],
      "min_strength_score": 2.0
    },
    {
      "id": "ER-HOLDOUT-001",
      "name": "corpus_holdout_protocol",
      "required_contract_ref": "holdout_protocol",
      "gates": {
        "monotonic_holdout_ids": true,
        "source_hash_required": true,
        "tuning_and_holdout_separated": true,
        "threshold_lowering_requires_waiver": true
      }
    },
    {
      "id": "ER-RUNTIME-001",
      "name": "no_network_no_model_runtime_eval",
      "required_contract_ref": "runtime_guards",
      "gates": {
        "frontier_model_calls_allowed": false,
        "network_access_allowed": false,
        "runtime_model_downloads_allowed": false,
        "python_ml_runtime_allowed": false,
        "general_ml_framework_runtime_allowed": false
      }
    },
    {
      "id": "ER-MEM-001",
      "name": "peak_memory_eval",
      "required_contract_ref": "peak_memory_targets",
      "measurement_method_required": true,
      "gates": {
        "small_ci_peak_memory_bytes_max": 268435456,
        "cmbs_public_peak_memory_bytes_max": 536870912,
        "regab_full_peak_memory_bytes_max": 536870912,
        "cmbs_500k_peak_memory_bytes_max": 2147483648,
        "cmbs_500k_unique_refusal_before_bytes": 4294967296
      }
    }
  ],
  "structural_performance_gates": {
    "row_level_all_pairs": "forbidden",
    "surface_level_all_pairs": "forbidden_except_tiny_explicit_fixtures",
    "exact_bucket_pair_expansion_count": 0,
    "exact_bucket_representation": "compact_hyperedge",
    "candidate_cap_scope": [
      "per_unique_surface",
      "per_operator"
    ],
    "candidate_pairs_per_surface_p95_max": 25,
    "candidate_pairs_per_surface_p99_max": 100,
    "review_groups_per_500k_cmbs_backfill_max": 2000,
    "cache_hit_rerun_rebuilds_normalization": false,
    "cache_hit_rerun_rebuilds_postings": false,
    "apply_replay_mode": "streaming",
    "unique_500k_required_behavior": "bounded_completion_or_deterministic_refusal"
  },
  "wall_clock_targets": [
    {
      "id": "PERF-SMALL-CI",
      "profile": "all",
      "tier": "small-ci",
      "workload": "small committed eval fixtures",
      "target_seconds": 1,
      "enforcement": "developer_target_not_brittle_ci_gate"
    },
    {
      "id": "PERF-REGAB-COMMITTED",
      "profile": "regab_firm_identity",
      "tier": "small-ci",
      "workload": "committed sec10d 46-surface fixture",
      "source": "tests/fixtures/entity/regab/sec10d_baseline_public",
      "target_seconds": 1,
      "enforcement": "developer_target_not_brittle_ci_gate"
    },
    {
      "id": "PERF-CMBS-PUBLIC",
      "profile": "cmbs_tenant_label",
      "tier": "public-sample",
      "workload": "CMBS public sample: 10143 tenant observations, 431 raw names",
      "source": "/Users/zacharyruiz/Downloads/tenant_sample_cmbs.csv",
      "target_seconds": 2,
      "enforcement": "operator_release_target_after_baseline"
    },
    {
      "id": "PERF-REGAB-FULL",
      "profile": "regab_firm_identity",
      "tier": "public-sample",
      "workload": "sec10d full baseline: 127991 mentions, 46 surfaces",
      "source": "/Users/zacharyruiz/Downloads/sec10d_regab_org_canon_baseline_20260623T204557Z.zip",
      "target_seconds": 10,
      "enforcement": "operator_release_target_after_baseline"
    },
    {
      "id": "PERF-REGAB-APPLY",
      "profile": "regab_firm_identity",
      "tier": "public-sample",
      "workload": "sec10d exact replay/apply full baseline",
      "target_seconds": 5,
      "enforcement": "operator_release_target_after_baseline"
    },
    {
      "id": "PERF-REGAB-PREPARE",
      "profile": "regab_firm_identity",
      "tier": "public-sample",
      "workload": "sec10d prepare/dedupe full baseline",
      "target_seconds": 5,
      "enforcement": "operator_release_target_after_baseline"
    },
    {
      "id": "PERF-CMBS-500K-WARM",
      "profile": "cmbs_tenant_label",
      "tier": "stress",
      "workload": "CMBS 500k rows, normal repetition, warm cache",
      "target_seconds": 120,
      "enforcement": "operator_release_target_after_baseline"
    },
    {
      "id": "PERF-CMBS-500K-COLD",
      "profile": "cmbs_tenant_label",
      "tier": "stress",
      "workload": "CMBS 500k rows, normal repetition, cold cache",
      "target_seconds": 300,
      "enforcement": "operator_release_target_after_baseline"
    },
    {
      "id": "PERF-CMBS-500K-APPLY",
      "profile": "cmbs_tenant_label",
      "tier": "stress",
      "workload": "CMBS exact apply/replay over 500k rows",
      "target_seconds": 15,
      "enforcement": "operator_release_target_after_baseline"
    },
    {
      "id": "PERF-CMBS-500K-UNIQUE",
      "profile": "cmbs_tenant_label",
      "tier": "stress",
      "workload": "CMBS 500k unique names",
      "target_seconds": null,
      "enforcement": "bounded_completion_or_deterministic_refusal"
    }
  ],
  "metamorphic_relations": [
    {
      "id": "MR-ROW-SHUFFLE",
      "relation_type": "equivalence",
      "score_strength": 5.0,
      "expected_invariant": "row order does not change prepared surfaces, candidates, edges, solve groups, review groups, or apply output after canonical sort",
      "allowed_differences": [
        "telemetry_run_id",
        "timings_ms_by_stage"
      ]
    },
    {
      "id": "MR-BATCH-SIZE",
      "relation_type": "equivalence",
      "score_strength": 5.0,
      "expected_invariant": "physical chunk size does not change semantic artifacts after canonical sort",
      "allowed_differences": [
        "timings_ms_by_stage",
        "cache_state"
      ]
    },
    {
      "id": "MR-DUPLICATE-ROWS",
      "relation_type": "count_preserving_inclusion",
      "score_strength": 3.2,
      "expected_invariant": "duplicating raw rows changes provenance and counts but not canonical surface identity, candidates, or merge decisions",
      "allowed_differences": [
        "raw_row_count",
        "raw_observation_count",
        "provenance_samples",
        "row_count_summaries"
      ]
    },
    {
      "id": "MR-CACHE-STATE",
      "relation_type": "equivalence",
      "score_strength": 4.0,
      "expected_invariant": "cold cache and warm cache runs produce identical semantic artifacts",
      "allowed_differences": [
        "cache_state",
        "timings_ms_by_stage"
      ]
    },
    {
      "id": "MR-HARMLESS-NOISE",
      "relation_type": "recall_floor",
      "score_strength": 3.0,
      "expected_invariant": "identity-preserving spelling, punctuation, case, spacing, and legal-suffix mutations keep candidate recall above the suite target",
      "allowed_differences": [
        "candidate_operator_distribution",
        "support_evidence_scores"
      ]
    },
    {
      "id": "MR-PROFILE-FIREWALL",
      "relation_type": "exclusive_refusal",
      "score_strength": 3.5,
      "expected_invariant": "artifacts from incompatible profiles refuse cross-profile review, promotion, and apply reuse",
      "allowed_differences": [
        "refusal_detail",
        "next_command"
      ]
    },
    {
      "id": "MR-APPLY-REPLAY-IDEMPOTENCE",
      "relation_type": "idempotence",
      "score_strength": 4.0,
      "expected_invariant": "applying the same approved registry snapshot twice produces byte-identical output and no extra registry mutation",
      "allowed_differences": [
        "telemetry_run_id",
        "timings_ms_by_stage"
      ]
    }
  ],
  "registry_mutation_safety": {
    "applies_to_commands": [
      "review import",
      "promote",
      "apply"
    ],
    "required_fields": [
      "registry_pre_mutation_hash",
      "registry_post_mutation_hash",
      "registry_snapshot_hash",
      "patch_hash",
      "audit_hash",
      "write_plan_hash",
      "atomic_write_mode",
      "refusal_code"
    ],
    "gates": {
      "refusal_paths_write_registry": false,
      "stale_registry_snapshot_writes": false,
      "failed_audit_writes": false,
      "atomic_temp_write_required": true,
      "idempotent_promote_required": true
    }
  },
  "explainability_contract": {
    "required_sections": [
      "input_surface",
      "profile_and_strategy",
      "normalized_views",
      "blocking_candidates",
      "support_evidence",
      "anti_merge_evidence",
      "relation_hints",
      "solver_decision",
      "review_or_patch_decision",
      "registry_snapshot",
      "promotion_provenance",
      "next_action"
    ],
    "per_decision_requirements": {
      "auto_merge": [
        "support_evidence",
        "absence_of_active_cannot_link"
      ],
      "review": [
        "positive_or_uncertainty_evidence",
        "anti_merge_or_relation_evidence",
        "next_action"
      ],
      "exact_replay": [
        "registry_id",
        "registry_version",
        "rule_id",
        "registry_snapshot_hash"
      ]
    }
  },
  "review_golden_contract": {
    "required_artifacts": [
      "review.csv",
      "review.jsonl",
      "review.summary.md",
      "review.expected_actions.json"
    ],
    "required_jsonl_fields": [
      "review_group_id",
      "profile",
      "surface_ids",
      "representative_raw_labels",
      "row_count",
      "deal_count",
      "positive_evidence",
      "anti_merge_evidence",
      "relation_evidence",
      "proposed_action",
      "reason_codes",
      "next_command"
    ],
    "stable_csv_headers_required": true,
    "summary_generated_from_jsonl_required": true
  },
  "holdout_protocol": {
    "series": [
      {
        "suite_prefix": "cmbs-public",
        "current_holdout_id": "cmbs-public-v1",
        "profile": "cmbs_tenant_label"
      },
      {
        "suite_prefix": "regab-baseline",
        "current_holdout_id": "regab-baseline-v1",
        "profile": "regab_firm_identity"
      }
    ],
    "required_manifest_fields": [
      "holdout_id",
      "source_hash",
      "fixture_selector_hash",
      "profile",
      "benchmark_ids",
      "expected_row_counts",
      "expected_surface_counts",
      "artifact_hash_policy",
      "threshold_waiver_bead_id"
    ],
    "gates": {
      "holdout_id_must_be_monotonic": true,
      "older_holdouts_are_append_only": true,
      "tuning_corpus_must_be_named": true,
      "threshold_lowering_requires_waiver": true
    }
  },
  "runtime_guards": {
    "network_access_allowed": false,
    "frontier_model_calls_allowed": false,
    "runtime_model_downloads_allowed": false,
    "python_ml_runtime_allowed": false,
    "general_ml_framework_runtime_allowed": false,
    "dense_embedding_service_allowed_for_large_corpora": false,
    "local_artifacts_require_content_hash": true,
    "runtime_guard_verdict_required": true
  },
  "peak_memory_targets": [
    {
      "id": "MEM-SMALL-CI",
      "profile": "all",
      "tier": "small-ci",
      "workload": "small committed eval fixtures",
      "max_bytes": 268435456,
      "measurement_method_required": true
    },
    {
      "id": "MEM-CMBS-PUBLIC",
      "profile": "cmbs_tenant_label",
      "tier": "public-sample",
      "workload": "CMBS public sample",
      "max_bytes": 536870912,
      "measurement_method_required": true
    },
    {
      "id": "MEM-REGAB-FULL",
      "profile": "regab_firm_identity",
      "tier": "public-sample",
      "workload": "sec10d full baseline",
      "max_bytes": 536870912,
      "measurement_method_required": true
    },
    {
      "id": "MEM-CMBS-500K",
      "profile": "cmbs_tenant_label",
      "tier": "stress",
      "workload": "CMBS 500k rows, normal repetition",
      "max_bytes": 2147483648,
      "measurement_method_required": true
    },
    {
      "id": "MEM-CMBS-500K-UNIQUE",
      "profile": "cmbs_tenant_label",
      "tier": "stress",
      "workload": "CMBS 500k unique names",
      "max_bytes": 4294967296,
      "enforcement": "bounded_completion_or_deterministic_refusal_before_limit",
      "measurement_method_required": true
    }
  ],
  "telemetry_required_fields": [
    "run_id",
    "suite_id",
    "profile",
    "canon_version",
    "git_sha",
    "rust_profile",
    "target_triple",
    "os",
    "cpu_model",
    "logical_cores",
    "memory_bytes",
    "cache_state",
    "input_hash",
    "profile_hash",
    "strategy_hash",
    "registry_snapshot_hash",
    "patch_hash",
    "holdout_id",
    "metamorphic_relation_id",
    "raw_row_count",
    "raw_observation_count",
    "raw_unique_surface_count",
    "prepared_surface_count",
    "exact_resolved_surface_count",
    "candidate_pair_count",
    "candidate_pairs_per_surface_p50",
    "candidate_pairs_per_surface_p95",
    "candidate_pairs_per_surface_p99",
    "suppressed_candidate_count",
    "exact_bucket_count",
    "exact_bucket_pair_expansion_count",
    "largest_exact_bucket_size",
    "largest_component_size",
    "edge_count",
    "review_group_count",
    "artifact_bytes_by_stage",
    "timings_ms_by_stage",
    "peak_memory_bytes",
    "peak_memory_method",
    "registry_pre_mutation_hash",
    "registry_post_mutation_hash",
    "runtime_guard_status",
    "refusal_code",
    "next_command"
  ],
  "no_theatre_rules": [
    "an eval cannot pass only because a file exists",
    "a benchmark cannot pass only because the command exited 0",
    "every merge decision must be explainable by support evidence",
    "every non-merge or review decision must expose anti-merge evidence or uncertainty",
    "wall-clock claims without telemetry are ignored",
    "500k results without candidate counts are ignored",
    "exact bucket expansion above zero is stop-ship",
    "hard-negative false merge is stop-ship"
  ]
}
