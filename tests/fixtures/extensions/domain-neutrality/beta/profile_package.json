        "solve_link",
        "review",
        "promote",
        "apply"
      ],
      "field_paths": [
        "beta_code",
        "caption",
        "segment"
      ],
      "outputs": [
        "prepare_bundle",
        "link_candidates",
        "link_decisions"
      ]
    }
  ],
  "limits": {
    "max_observation_fields": 8,
    "max_candidate_pairs": 3000,
    "max_outputs": 500
  },
  "expected_outputs": [
    "prepare_bundle",
    "cluster_assignments",
    "review_queue",
    "link_candidates",
    "link_decisions"
  ],
  "project_overrides": [
    {
      "key": "candidate_limit",
